          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Requests",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service_name=\"edge-proxy\"} | json | site=~\"$site\" | line_format \"{{.status}} {{.outcome}} · {{.client}} · {{.network}} · {{.country_code}} {{.city}} · {{.asn_org}} · {{.client_ip}} · {{.method}} {{.site}}{{._entry}} · {{.user_agent}}\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
