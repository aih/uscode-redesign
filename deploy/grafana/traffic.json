    {
      "id": 16,
      "type": "bargauge",
      "title": "Areas asked for",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (site, area, pinned) (count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))",
          "legendFormat": "{{site}} · {{area}} · pinned release: {{pinned}}",
          "queryType": "instant"
        }
      ],
      "description": "reader: /app pages. asset: /app scripts, styles, fonts and icons. api: /api. citation: the /us/… redirector. pinned release: the address carries ?release=, ?date= or ?id=.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "minVizHeight": 16,
        "maxVizHeight": 22
      },
      "fieldConfig": {
