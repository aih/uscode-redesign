{
  "uid": "uscode-traffic",
  "title": "Traffic sources",
  "tags": [
    "uscode"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "editable": true,
  "description": "Requests at the edge by location, network and client (ADR-0096). Location and network: IP Geolocation by DB-IP (https://db-ip.com), CC BY 4.0.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "IP Geolocation by DB-IP",
      "url": "https://db-ip.com",
      "type": "link",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/grafanacloud-.*-logs/",
        "hide": 2
      },
      {
        "name": "site",
        "label": "Site",
        "type": "custom",
        "query": "uscode.linkedlegislation.org,statutes.linkedlegislation.org",
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Every request the edge answered for the selected site in the time range, assets included.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Client addresses",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (client_ip) (count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Distinct client addresses in the time range.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "From cloud and hosting networks",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" | network=\"cloud\" [$__range])) / sum(count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Share of requests from an address whose network is a cloud or hosting provider.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Answered with a 403 or 429",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" | outcome=~\"blocked|cookie-gate|rate-limited\" [$__range])) / sum(count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Share of requests the edge answered with a crawler block, the cookie gate's challenge or a rate limit.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second by network type",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (network) (rate({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__auto]))",
          "legendFormat": "{{network}}",
          "queryType": "range"
        }
      ],
      "description": "cloud: a cloud or hosting provider. isp: a consumer or business internet provider. education, government: from the network's registered name. unknown: an address the ASN database does not list.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per second by client type",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (client) (rate({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__auto]))",
          "legendFormat": "{{client}}",
          "queryType": "range"
        }
      ],
      "description": "From the User-Agent: ai-crawler, search-engine, other-bot (a declared bot or monitor), script (curl, python and other HTTP libraries), browser, other, none (no User-Agent).",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Network type",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (network) (count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))",
          "legendFormat": "{{network}}",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Client type",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (client) (count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))",
          "legendFormat": "{{client}}",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "What the edge answered",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (outcome) (count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))",
          "legendFormat": "{{outcome}}",
          "queryType": "instant"
        }
      ],
      "description": "served: 2xx or 3xx. cookie-gate: the reader's 403 that sets the cookie. blocked: the crawler User-Agent 403. rate-limited: 429. client-error: another 4xx. server-error: 5xx.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Countries",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sort_desc(topk(20, sum by (country) (count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))))",
          "legendFormat": "{{country}}",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "minVizHeight": 16,
        "maxVizHeight": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Regions",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sort_desc(topk(20, sum by (region, country_code) (count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))))",
          "legendFormat": "{{region}}, {{country_code}}",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "minVizHeight": 16,
        "maxVizHeight": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Cities",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sort_desc(topk(20, sum by (city, region, country_code) (count_over_time({service_name=\"edge-proxy\"} | json | site=~\"$site\" [$__range]))))",
          "legendFormat": "{{city}}, {{region}}, {{country_code}}",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
