{
  "uid": "uscode-sites",
  "title": "US Code and Statutes sites",
  "tags": [
    "uscode"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/grafanacloud-.*-prom/",
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "/grafanacloud-.*-traces/",
        "hide": 2
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/grafanacloud-.*-logs/",
        "hide": 2
      },
      {
        "name": "job",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count, job)",
          "refId": "job"
        },
        "definition": "label_values(http_server_request_duration_seconds_count, job)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests, last 24 hours",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (increase(http_server_request_duration_seconds_count{job=~\"$job\"}[24h]))",
          "legendFormat": "{{job}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests per second, now",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[5m]))",
          "legendFormat": "{{job}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Server errors (5xx), last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (increase(http_server_request_duration_seconds_count{job=~\"$job\", http_response_status_code=~\"5..\"}[1h])) or sum by (job) (http_server_request_duration_seconds_count{job=~\"$job\"}) * 0",
          "legendFormat": "{{job}}",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second, same time last week",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} now",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval] offset 1w))",
          "legendFormat": "{{job}} last week",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency, p50 and p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{job}} p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{job}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Responses by status code",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Busiest routes",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (job, http_route) (rate(http_server_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{job}} {{http_route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Slowest routes, p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, job, http_route) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval]))))",
          "legendFormat": "{{job}} {{http_route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (http_server_active_requests{job=~\"$job\"})",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Slow traces (over 1 s)",
      "datasource": {
        "type": "tempo",
        "uid": "${tempo}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{resource.service.name=~\"uscode-api|statutes-api\" && duration > 1s}",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo}"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Exceptions and validation failures",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"uscode-api|statutes-api\"}",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ]
    }
  ]
}
