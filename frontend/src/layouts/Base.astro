---
/**
 * The shell every reader page shares: skip link, navbar, contextual bar, footer.
 *
 * Landmarks are not decoration here — a skip-nav link, `<header>`/`<main>`/
 * `<footer>`, and one `<h1>` per page are what make a document of statutory text
 * navigable by keyboard and screen reader, which is the whole reason ADR-0011
 * chose a design system with Section 508 as its stated bar.
 *
 * No client JavaScript is loaded. Not "as little as possible" — none. Statutory
 * text is a document; islands come later, for the things that genuinely interact.
 */
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ReleaseContext from "../components/ReleaseContext.astro";
import ReleasePicker from "../components/ReleasePicker.astro";
import SectionBar from "../components/SectionBar.astro";
import PrintHeader from "../components/PrintHeader.astro";
import CommandPalette from "../components/CommandPalette.astro";
import ShortcutsDialog from "../components/ShortcutsDialog.astro";
import KeyboardNav from "../components/KeyboardNav.astro";
import type { PaletteCommand } from "../lib/palette";
import type { Entry, Release } from "../lib/types";
import "../styles/site.scss";

/** What the compact sticky row shows — the section's identity and its exits.
 * Supplied only by pages that *are* a place in the Code; the front page and the
 * auth pages pass nothing and get no bar. */
export interface Bar {
  num?: string | null;
  heading?: string | null;
  status?: string | null;
  previous?: Entry | null;
  next?: Entry | null;
  up?: Entry | null;
}

interface Props {
  title: string;
  crumbs?: Entry[];
  /** The node being read, rendered as the trail's last, unlinked item. */
  current?: Entry | null;
  release?: string | null;
  /** The four facts about the text on screen, stated once for every page that
   *  shows a provision rather than assembled per page (ADR-0044). */
  releaseContext?: {
    served: Release;
    isNewest?: boolean;
    newestHref?: string | null;
    note?: string | null;
  } | null;
  picker?: { action: string; options: Release[]; selected: string } | null;
  bar?: Bar | null;
  /** What the header's search box should already contain.
   *
   * The search and go-to pages used to render a second, larger copy of
   * `SiteSearch` in the page body so the reader could see and edit the query
   * that produced the results. That put two identical boxes on screen at once,
   * the header's one sticky above the page's one — and left the sticky box
   * empty while the page box held the query, so whichever one you reached for
   * first was the wrong one. Prefilling the single box the site already has is
   * the same affordance without the double. */
  searchValue?: string | null;
  /** Rows the command palette offers on top of the site-wide ones (ADR-0062).
   *
   * Only a page with a provision on screen has any: "compare with the previous
   * release point" and "version history" both need a section identifier, and
   * the first also needs the title's release list, which the section page has
   * already fetched for the release switcher. */
  commands?: PaletteCommand[];
  /** Set by a page that fills the `rail` slot. See `hasRail` below. */
  rail?: boolean;
  /** Widens the page beyond the 46rem reading measure.
   *
   * The measure is set for statutory text and is right for it. The user guide
   * (ADR-0038) is the one thing here that is not statutory text: it carries a
   * chapter contents column beside its prose, and inside 46rem those two share
   * a width meant for one, leaving a 28rem column of prose next to a sidebar
   * eating the margin. Only the guide passes this. */
  wide?: boolean;
}

const {
  title,
  crumbs = [],
  current = null,
  release = null,
  releaseContext = null,
  picker = null,
  bar = null,
  searchValue = null,
  commands = [],
  rail = false,
  wide = false,
} = Astro.props;
const hasContext = crumbs.length > 0 || current !== null || picker !== null;
/** The release facts, at the top of the content, on every page that knows which
 *  release point it is showing. The *switcher* is no longer under them — it is
 *  in the sticky bar, folded into the line that states the release point. */
const hasReleaseBlock = releaseContext !== null;
/** Whether this page is supplying the `rail` slot, and so wants the two-column
 *  reading layout. The guide asks for `wide` directly; a rail implies it.
 *
 *  A prop rather than `Astro.slots.has("rail")`, which does not answer this
 *  question: a page whose slot content is behind a condition
 *  (`{rail && <ChapterRail slot="rail" …/>}`) reports `true` from `has()` even
 *  when the condition is false, so every table-of-contents page took the
 *  two-column layout and the wide measure with nothing in the first column. */
const hasRail = rail;
const mainClass = wide || hasRail ? "reader-wrap reader-wrap--wide" : "reader-wrap";

/** Where this page came from, for the printed running header (ADR-0054).
 *
 *  From the request's own `Host` rather than a configured canonical origin,
 *  because there is no configured canonical origin — the same image serves
 *  `localhost:8000` in development and `uscode.linkedlegislation.org` on the
 *  box, and the URL worth printing is the one the reader actually used. The
 *  scheme is left off: it is noise on paper and the host answers on both. */
const printSource = `${Astro.request.headers.get("host") ?? ""}${Astro.url.pathname}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* `viewport-fit=cover` lets a standalone window draw to the edges of a
        notched screen; the safe-area padding in `site.scss` (ADR-0079) is the
        other half, and the two only land together. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="Any provision of the US Code, at any release point." />

    {/* The tab mark. Root-absolute, not `/app/...`: it is served by the API
        (`main.py`), which is what everything outside `/app` reaches, so one
        file answers for the reader and for both API docs pages. An SVG because
        the mark is three letters and a square — it should be sharp on a 4K tab
        strip and legible at 16px, and one vector file is both. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#31509d" />

    {/* The reader as an installable app (ADR-0079). The manifest names the
        identity — /app/ scope, standalone display, the generated icons — and
        is what makes a browser offer to install; the apple-touch icon is
        linked as well because iOS prefers it over the manifest's. Static
        files out of `public/`, like the fonts below; asserted by
        `tests/pwa.test.ts`. */}
    <link rel="manifest" href="/app/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/app/icons/apple-touch-icon-180.png" />

    {/* The colour an installed window paints its title bar. The default is
        the light theme's `--page` and the bootstrap below corrects it before
        first paint for a reader who chose dark; `ThemeToggle` moves it on
        every toggle. The manifest's `theme_color` cannot follow a runtime
        theme — this meta is the only thing that can. Both values are the
        token block's `--page` (`site.scss`), asserted by `tests/pwa.test.ts`. */}
    <meta name="theme-color" content="#f9f9f7" />

    {/* The two faces every page paints text in before it paints anything else:
        Archivo for the chrome, Spectral for the provision (ADR-0052). A webfont
        is discovered only when the stylesheet that names it has parsed, which is
        one round trip too late; these ask for them alongside the CSS.

        Only the roman faces. Italic and bold are real files and are declared in
        `site.scss`, but a page that needs neither should not pay 66 KB for the
        possibility. `crossorigin` is required even same-origin — a font is
        fetched in CORS mode, and a preload without it fetches the file twice.

        Not built through `lib/url.ts`: that module addresses reader *routes*,
        and these are static files out of `public/`, the same way the favicon
        above is. Their existence is asserted by `tests/fonts.test.ts`. */}
    <link
      rel="preload"
      href="/app/fonts/archivo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/app/fonts/spectral-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* The theme, before first paint.

        Light is the default for everyone (`site.scss`), so the common case
        needs no script at all — this only matters for the reader who has
        chosen dark, and for them it has to run *here*, blocking, in the head.
        Anywhere later and they get a white flash on every navigation, which is
        the one thing a dark theme exists to avoid.

        Inline and tiny by necessity: an external module would be a network
        round trip in front of the first paint of every page. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem("usc-theme");
        if (stored === "dark" || stored === "light") {
          document.documentElement.dataset.theme = stored;
        }
        /* Reading density, on the same terms and for the same reason
           (ADR-0054): it moves the reading size, so applied any later it
           reflows the column in front of the reader. Same script, so it costs
           no second blocking round trip. */
        const density = localStorage.getItem("usc-density");
        if (density === "compact" || density === "comfortable") {
          document.documentElement.dataset.density = density;
        }
      } catch {
        // No storage (private mode, blocked cookies) — the default stands.
      }
      /* The title-bar colour of an installed window (ADR-0079), moved with
         the theme so a dark reader does not sit under a light bar. The meta
         above defaults to light; only dark needs a correction, here, before
         first paint. The two values are the token block's `--page`. */
      if (document.documentElement.dataset.theme === "dark") {
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.setAttribute("content", "#141310");
      }
    </script>

    <script is:inline>
      {
        /* Where links open.
         *
         * Cross references and search results ship with `target="_blank"`
         * (`lib/uslm.ts`) because the HTML is shared by every reader — a page
         * in a public cache cannot carry one reader's preference (ADR-0018,
         * the same reasoning that keeps the theme out of a cookie in
         * ADR-0027). So the markup states the default and this takes it back
         * off for whoever asked for that.
         *
         * It only ever touches anchors carrying `data-newtab` — the ones the
         * markup deliberately opted in. That is the safety property: a reader
         * with scripting off, or with this script broken, gets the documented
         * default, and no link anywhere else on the site is affected either
         * way.
         *
         * It has to restore as well as remove. `AuthNav` can call this a second
         * time with a *different* answer — the account said new-tab while this
         * browser had been set to same-tab — and a remove-only version would
         * leave that reader's links stripped until they reloaded.
         *
         * It runs on DOMContentLoaded rather than blocking in the head:
         * `target` matters at click time, not at paint time, so there is no
         * flash to prevent — unlike the theme, which does have to block. A
         * signed-in reader's stored preference is written into `localStorage`
         * by `AuthNav`, which is how the choice follows them to another
         * browser. */
        function applyLinkTarget() {
          /* An installed window behaves as `usc-linktarget === "same"`
             (ADR-0079): a new tab opened from standalone lands in a browser
             outside the app, so every cross reference and search result would
             walk the reader out of what they installed. */
          let sameTab =
            matchMedia("(display-mode: standalone)").matches ||
            navigator.standalone === true;
          try {
            sameTab = sameTab || localStorage.getItem("usc-linktarget") === "same";
          } catch {
            // No storage — the default in the markup stands.
          }
          for (const link of document.querySelectorAll("a[data-newtab]")) {
            if (sameTab) link.removeAttribute("target");
            else link.setAttribute("target", "_blank");
          }
        }

        document.addEventListener("DOMContentLoaded", applyLinkTarget);
        // `AuthNav` fires this once it has the signed-in reader's stored
        // setting, which can disagree with what this browser had.
        document.addEventListener("usc:linktarget", applyLinkTarget);
      }
    </script>

    {/* The offline fallback (ADR-0080). Registered on `load` so it costs the
        first paint nothing, with `updateViaCache: "none"` so the worker
        script itself is always checked against the network. Everything the
        worker does is an enhancement — a browser without it, or a failed
        registration, is the site exactly as it was. */}
    <script is:inline>
      if ("serviceWorker" in navigator) {
        addEventListener("load", () => {
          navigator.serviceWorker.register("/app/sw.js", { updateViaCache: "none" }).catch(() => {
            // No worker — the site is unchanged without one.
          });
        });
      }
    </script>
  </head>
  <body>
    <a class="usa-skipnav" href="#main">Skip to main content</a>

    {/* The printed page's running header (ADR-0054). `display: none` on screen,
        repeated in the top margin of every sheet in `@media print`. A direct
        child of `<body>`, because a `position: fixed` box only repeats across
        pages when nothing between it and the page is establishing a containing
        block of its own. */}
    <PrintHeader identifier={current?.identifier} release={release} source={printSource} />

    {/* One sticky stack, so scrolling statutory text never costs you the answer
        to "where am I" or "as of when". Desktop keeps the whole thing; below
        40em only `.sectionbar` inside it stays put and the rest scrolls away
        (`site.scss`). Anything that sticks has to be paid for in
        `--sticky-h`, which drives `scroll-margin-top` — otherwise a deep link
        to a provision lands *behind* this. */}
    <div class={hasRail ? "topbar topbar--wide" : "topbar"}>
      <SiteHeader searchValue={searchValue} />

      {
        hasContext && (
          <div class="contextbar">
            <div class="contextbar__inner">
              <Breadcrumbs crumbs={crumbs} current={current} release={release} />
              {/* "As of when", stated and changed in one place. The switcher is
                  a `<details>` whose closed summary carries the same words the
                  plain `<p>` below it carries, so the sticky stack costs the
                  same either way and `--sticky-h` does not move; the panel it
                  opens is absolutely positioned and paints over the page.

                  The `<p>` is the fallback for a page that knows its release
                  point and has no list of the others to offer — a title or
                  chapter table of contents whose release lookup failed, and the
                  design system's own specimen. */}
              {
                picker ? (
                  <ReleasePicker {...picker} />
                ) : (
                  release && (
                    <p class="contextbar__rp">
                      <span class="contextbar__rplabel">Release point</span> {release}
                    </p>
                  )
                )
              }
            </div>
          </div>
        )
      }

      {bar && <SectionBar {...bar} release={release} />}
    </div>

    {/* A page supplying the `rail` slot gets two columns from 64em and the wider
        measure to hold them, the same arrangement `.guide__nav` uses. Without
        the slot the markup is unchanged — one column, one `<slot />` — so no
        page that does not ask for a rail pays for one. */}
    <main id="main" class={mainClass}>
      <div class={hasRail ? "reader-layout" : "reader-layout reader-layout--single"}>
        {hasRail && <slot name="rail" />}
        <div class="reader-col">
          {
            hasReleaseBlock && (
              <div class="releaseblock">
                <ReleaseContext {...releaseContext!} />
              </div>
            )
          }
          <slot />
        </div>
      </div>
    </main>

    <SiteFooter />

    {/* The shortcut list and the keys that reach it, on every page.

        Here rather than on the section page, which is where three of these
        keys started. `/` and `?` belong to the site: a search box reachable
        only by tabbing past the navbar is a search box for the pointer, and a
        list of shortcuts you can only summon from the page whose shortcuts you
        already know is not a list anybody finds. The section keys go quiet on a
        page with no section — `KeyboardNav` is handed no destinations and the
        in-page targets are not in the document.

        The dialog first, because the island looks it up by id on the way in.

        The palette is ahead of both: its own script closes it when the shortcut
        row is clicked, and that listener has to be attached before
        `KeyboardNav`'s opens the help dialog on the same click. */}
    <CommandPalette commands={commands} />
    <ShortcutsDialog />
    {/* What a shortcut says when it did nothing. `[` and `]` on a section with
        no top-level provisions — a one-paragraph repeal — used to be silent,
        which is indistinguishable from a key that is not bound. Polite, so it
        does not interrupt; on screen as well as announced, because a sighted
        reader pressing a key that appears dead needs the same sentence. */}
    <p class="keysay" id="keysay" role="status" aria-live="polite"></p>
    <KeyboardNav
      previous={bar?.previous}
      next={bar?.next}
      up={bar?.up}
      release={release}
    />
  </body>
</html>
