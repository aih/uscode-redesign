---
/**
 * `/app/diff/…?from=&to=` — a redline between two release points of a section
 * (Day 4, ADR-0016; rewritten in ADR-0026).
 *
 * **It used to show the XML.** The API diffs the two verbatim fragments, and
 * this page escaped those ops and printed them — so a reader who asked what
 * changed in § 45f got `<section identifier="…" id="id0b32…">` struck through
 * and an identical element with a fresh guid inserted, because guids regenerate
 * at every release point by design. The markup was the loudest thing on the
 * page and the least informative.
 *
 * Now the page renders both versions as reading text (`uslm.readingBlocks`) and
 * diffs *those* (`lib/diffdoc.ts`): the redline is of what the section says.
 * The source-level redline has not gone anywhere — it is what the API serves,
 * and it is linked at the foot of this page for anyone who wants the bytes.
 *
 * Two fetches rather than one call to `/sections/{id}/diff`, because the text
 * diff is computed here: the USLM vocabulary needed to turn a fragment into
 * lines a reader reads lives in `lib/uslm.ts` and nowhere else (architecture
 * rule 5), which puts it on this side of the HTTP boundary.
 */
import Base from "../../layouts/Base.astro";
import ErrorPage from "../../components/ErrorPage.astro";
import { ApiError, fetchIdentifier, fetchVersions } from "../../lib/api";
import { IMMUTABLE, REVALIDATE } from "../../lib/cache";
import { documentDiff, diffLinesHtml } from "../../lib/diffdoc";
import type { DocumentDiff } from "../../lib/diffdoc";
import { apiDiffHref, appHref, trimNum, versionsHref } from "../../lib/url";
import { parseFragment, readingBlocks } from "../../lib/uslm";
import type { Section } from "../../lib/types";
import { isToc } from "../../lib/types";

// The route's own static prefix is "diff", not "us/usc" (unlike the
// identifier catch-all page) — the captured param already carries "us/usc/…".
const identifier = `/${Astro.params.identifier ?? ""}`.replace(/\/+$/u, "");
const from = Astro.url.searchParams.get("from");
const to = Astro.url.searchParams.get("to");

let before: Section | null = null;
let after: Section | null = null;
let failure: { status: number; detail: string } | null = null;

if (!from || !to) {
  failure = { status: 400, detail: "Add ?from=<release>&to=<release> to compare two versions." };
  Astro.response.status = 400;
} else {
  try {
    const [a, b] = await Promise.all([
      fetchIdentifier(identifier, { release: from }),
      fetchIdentifier(identifier, { release: to }),
    ]);
    if (isToc(a) || isToc(b)) {
      failure = {
        status: 400,
        detail: "That identifier is a table of contents, not a section. Diffs are per section.",
      };
      Astro.response.status = 400;
    } else {
      before = a;
      after = b;
    }
  } catch (error) {
    if (error instanceof ApiError) {
      failure = { status: error.status, detail: error.detail };
      Astro.response.status = error.status;
    } else {
      throw error;
    }
  }
}

let diff: DocumentDiff | null = null;
if (before && after) {
  diff = documentDiff(readingBlocks(parseFragment(before.xml)), readingBlocks(parseFragment(after.xml)));
}

// Both endpoints are named in the URL, so this redline is as fixed as the two
// published texts it is drawn from — but only if each label resolved to itself.
// A bare `119-102` resolving to `119-102not101` is a different release point
// than the URL asked for, and the URL's meaning would change once `119-102`
// existed, so those revalidate instead.
const pinned = Boolean(
  before && after && before.release.label === from && after.release.label === to,
);
Astro.response.headers.set("Cache-Control", pinned ? IMMUTABLE : REVALIDATE);

// The picker on this page reuses the section's own version list, so a reader
// can pivot to a different pair without going back to the timeline page.
const versions = after ? await fetchVersions(identifier).catch(() => null) : null;
const entries = versions?.versions ?? [];

const unchanged = diff !== null && diff.changed === 0 && diff.inserted === 0 && diff.deleted === 0;

/** "3 lines changed, 1 added" — the shape of the amendment, before the reader
 * starts reading it. */
function summary(d: DocumentDiff): string {
  const parts: string[] = [];
  if (d.changed) parts.push(`${d.changed} line${d.changed === 1 ? "" : "s"} changed`);
  if (d.inserted) parts.push(`${d.inserted} added`);
  if (d.deleted) parts.push(`${d.deleted} removed`);
  return parts.join(", ");
}

const title = after
  ? `Diff ${before?.release.label} → ${after.release.label} · ${trimNum(after.num)} · U.S. Code`
  : "Diff · U.S. Code";
---

<Base title={title}>
  {failure && <ErrorPage status={failure.status} detail={failure.detail} />}

  {
    before && after && diff && (
      <>
        <h1 class="doc-title">
          <span class="doc-title__num">{trimNum(after.num)}</span>
          {after.heading}
        </h1>

        <p class="doc-meta">
          <a href={appHref(identifier, after.release.label)}>← Back to the current text</a>
          {" · "}
          <a href={versionsHref(identifier)}>Version history</a>
        </p>

        <p class="lede">
          Comparing <strong>{before.release.label}</strong> to{" "}
          <strong>{after.release.label}</strong>.{" "}
          {unchanged
            ? "The text of this section is identical at both release points."
            : summary(diff) + "."}
        </p>

        {entries.length > 1 && (
          <form class="diff-picker" method="get" action={`/app/diff${identifier}`}>
            <div>
              <label class="usa-label picker__label" for="from">
                From
              </label>
              <select class="usa-select picker__select" id="from" name="from">
                {entries.map((entry) => (
                  <option value={entry.first_seen.label} selected={entry.first_seen.label === from}>
                    {entry.first_seen.label}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label class="usa-label picker__label" for="to">
                To
              </label>
              <select class="usa-select picker__select" id="to" name="to">
                {entries.map((entry) => (
                  <option value={entry.first_seen.label} selected={entry.first_seen.label === to}>
                    {entry.first_seen.label}
                  </option>
                ))}
              </select>
            </div>
            <button class="usa-button picker__go" type="submit">
              Diff
            </button>
          </form>
        )}

        <div class="diff-view diff-view--text" set:html={diffLinesHtml(diff.lines)} />

        {/* The XML is still there for whoever wants it — this page just no
            longer makes everyone else read it. */}
        <p class="doc-meta">
          Prefer the source? The API serves the same comparison as a{" "}
          <a href={apiDiffHref(identifier, from ?? "", to ?? "")}>redline of the verbatim XML</a>.
        </p>
      </>
    )
  }
</Base>
