---
/**
 * `/app/diff/…?from=&to=` — a redline between two release points of a section
 * (Day 4, ADR-0016; rewritten in ADR-0026).
 *
 * **It used to show the XML.** The API diffs the two verbatim fragments, and
 * this page escaped those ops and printed them — so a reader who asked what
 * changed in § 45f got `<section identifier="…" id="id0b32…">` struck through
 * and an identical element with a fresh guid inserted, because guids regenerate
 * at every release point by design. The markup was the loudest thing on the
 * page and the least informative.
 *
 * Now the page renders both versions as reading text (`uslm.readingBlocks`) and
 * diffs *those* (`lib/diffdoc.ts`): the redline is of what the section says.
 * The source-level redline has not gone anywhere — it is what the API serves,
 * and this page renders it too, in the "Source XML" panel below, opt-in behind
 * `?source=1` for anyone who wants the bytes.
 *
 * Two fetches rather than one call to `/sections/{id}/diff`, because the text
 * diff is computed here: the USLM vocabulary needed to turn a fragment into
 * lines a reader reads lives in `lib/uslm.ts` and nowhere else (architecture
 * rule 5), which puts it on this side of the HTTP boundary.
 */
import Base from "../../layouts/Base.astro";
import ErrorPage from "../../components/ErrorPage.astro";
import { ApiError, fetchIdentifier, fetchVersions } from "../../lib/api";
import { IMMUTABLE, REVALIDATE } from "../../lib/cache";
import { documentDiff, diffLinesHtml, diffSummary, sourceDelta } from "../../lib/diffdoc";
import type { DocumentDiff, SourceDelta } from "../../lib/diffdoc";
import { apiDiffHref, appHref, diffHref, trimNum, versionsHref } from "../../lib/url";
import { sourceRedline } from "../../lib/xmlredline";
import { parseFragment, readingBlocks } from "../../lib/uslm";
import type { Entry, Section } from "../../lib/types";
import { isToc } from "../../lib/types";

// The route's own static prefix is "diff", not "us/usc" (unlike the
// identifier catch-all page) — the captured param already carries "us/usc/…".
const identifier = `/${Astro.params.identifier ?? ""}`.replace(/\/+$/u, "");
const from = Astro.url.searchParams.get("from");
const to = Astro.url.searchParams.get("to");

let before: Section | null = null;
let after: Section | null = null;
let failure: { status: number; detail: string } | null = null;

if (!from || !to) {
  failure = { status: 400, detail: "Add ?from=<release>&to=<release> to compare two versions." };
  Astro.response.status = 400;
} else {
  try {
    const [a, b] = await Promise.all([
      fetchIdentifier(identifier, { release: from }),
      fetchIdentifier(identifier, { release: to }),
    ]);
    if (isToc(a) || isToc(b)) {
      failure = {
        status: 400,
        detail: "That identifier is a table of contents, not a section. Diffs are per section.",
      };
      Astro.response.status = 400;
    } else {
      before = a;
      after = b;
    }
  } catch (error) {
    if (error instanceof ApiError) {
      failure = { status: error.status, detail: error.detail };
      Astro.response.status = error.status;
    } else {
      throw error;
    }
  }
}

let diff: DocumentDiff | null = null;
if (before && after) {
  diff = documentDiff(readingBlocks(parseFragment(before.xml)), readingBlocks(parseFragment(after.xml)));
}

// Both endpoints are named in the URL, so this redline is as fixed as the two
// published texts it is drawn from — but only if each label resolved to itself.
// A bare `119-102` resolving to `119-102not101` is a different release point
// than the URL asked for, and the URL's meaning would change once `119-102`
// existed, so those revalidate instead.
const pinned = Boolean(
  before && after && before.release.label === from && after.release.label === to,
);
Astro.response.headers.set("Cache-Control", pinned ? IMMUTABLE : REVALIDATE);

// The picker on this page reuses the section's own version list, so a reader
// can pivot to a different pair without going back to the timeline page.
const versions = after ? await fetchVersions(identifier).catch(() => null) : null;
const entries = versions?.versions ?? [];

const unchanged = diff !== null && diff.changed === 0 && diff.inserted === 0 && diff.deleted === 0;

// An empty redline establishes that nothing *readable* changed — never that the
// source republished nothing, which it does at every release point (gotcha 1).
// So it decides whether the source redline has anything to show: `identical` is
// two byte-for-byte equal fragments and nothing to send a reader to, and the
// other two are metadata the reading view cannot display.
const delta: SourceDelta | null =
  unchanged && before && after ? sourceDelta(before.xml, after.xml) : null;
const sourceDiffers = delta !== null && delta !== "identical";

// The guids, which are the metadata most likely to have moved. `guid` is
// resolved per (identifier, release) from `guid_map`, so it is release-specific
// even when the *stored fragment* is shared — under ADR-0007's dedupe two
// release points with the same content resolve to one row, and that row carries
// the guids of the release the text first appeared at. So an unchanged section
// can, and normally does, have two different guids and one set of @id
// attributes. That is worth saying outright rather than leaving a reader to
// conclude the source republished nothing.
const guidsDiffer = Boolean(
  before && after && before.guid && after.guid && before.guid !== after.guid,
);
const fragmentFrom =
  delta === "identical" && after ? after.content_first_seen.label : null;

// The source-level redline, in the page rather than linked away to JSON.
// Computed only when asked (`?source=1`): it is the expensive one, and Node has
// one event loop. See `lib/xmlredline.ts` for why it is not an API call.
const showSource = Astro.url.searchParams.get("source") === "1";
const source = showSource && before && after ? sourceRedline(before.xml, after.xml) : null;

/** The same page with the source panel toggled. Built by hand rather than
 *  through `diffHref` because it carries a third parameter that only this page
 *  knows about. */
function sourceToggleHref(on: boolean): string {
  const params = new URLSearchParams({ from: from ?? "", to: to ?? "" });
  if (on) params.set("source", "1");
  return `${diffHref(identifier, from ?? "", to ?? "").split("?")[0]}?${params.toString()}`;
}

const title = after
  ? `Diff ${before?.release.label} → ${after.release.label} · ${trimNum(after.num)} · U.S. Code`
  : "Diff · U.S. Code";

// The trail comes from the newer of the two texts, which is the one this page is
// framed around. No release band and no switcher here: this page is *about* two
// release points, so a bar naming one of them would be answering a question the
// page does not ask. The two labels are in the lede, and in the from/to picker.
const crumbs: Entry[] = after?.ancestors ?? [];
const currentCrumb: Entry | null = after
  ? {
      identifier: after.identifier,
      level: "section",
      num: after.num,
      heading: after.heading,
      status: after.status,
      is_section: true,
    }
  : null;
---

<Base title={title} crumbs={crumbs} current={currentCrumb}>
  {failure && <ErrorPage status={failure.status} detail={failure.detail} />}

  {
    before && after && diff && (
      <>
        <h1 class="doc-title">
          <span class="doc-title__num">{trimNum(after.num)}</span>
          {after.heading}
        </h1>

        <p class="doc-meta">
          <a href={appHref(identifier, after.release.label)}>← Back to the current text</a>
          {" · "}
          <a href={versionsHref(identifier)}>Version history</a>
        </p>

        {/* The result first, and only the result: "No changes", "2 lines
            added". What the source did to the markup while saying the same
            thing is a fact about USLM rather than about the law, and it used to
            arrive in the same sentence as the answer. */}
        <p class="lede">
          Comparing <strong>{before.release.label}</strong> to{" "}
          <strong>{after.release.label}</strong>.{" "}
          <strong class="diff-verdict">{diffSummary(diff)}.</strong>
        </p>

        {/* One line, and only where there is something behind the link. Which
            of `sourceDelta`'s two differing cases it is — guids alone, or an
            attribute beyond them — is what the source redline itself shows, so
            three paragraphs of prose were describing a view one click away. */}
        {sourceDiffers && (
          <p class="doc-meta">
            The{" "}
            {/* No whitespace inside the anchor: Astro keeps it, and a newline
                becomes an underlined space hanging off the link. */}
            <a
              href={showSource ? "#source" : `${sourceToggleHref(true)}#source`}
              rel="nofollow"
              data-source-render={showSource ? undefined : ""}
            >source-level redline</a>{" "}
            shows the changed metadata (e.g. guids, whitespace) as well.
          </p>
        )}

        {unchanged && (guidsDiffer || fragmentFrom) && (
          <p class="doc-meta">
            {guidsDiffer && (
              <>
                Its <abbr title="The USLM @id attribute: a pin on this provision at
                this release point, regenerated at every one by design. Never a
                cross-release identity — that is @identifier's job.">guid</abbr>{" "}
                did change, as it does at every release point:{" "}
                <code>{before?.guid}</code> → <code>{after?.guid}</code>.{" "}
              </>
            )}
            {fragmentFrom && (
              <>
                The <code>@id</code> attributes inside the XML above are those of{" "}
                <strong>{fragmentFrom}</strong>, where this text first appeared.
                Identical content is stored once, so the fragment carries that
                release's guids, not the guids of either release being compared.
              </>
            )}
          </p>
        )}

        {entries.length > 1 && (
          <form class="diff-picker" method="get" action={`/app/diff${identifier}`}>
            <div>
              <label class="usa-label picker__label" for="from">
                From
              </label>
              <select class="usa-select picker__select" id="from" name="from">
                {entries.map((entry) => (
                  <option value={entry.first_seen.label} selected={entry.first_seen.label === from}>
                    {entry.first_seen.label}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label class="usa-label picker__label" for="to">
                To
              </label>
              <select class="usa-select picker__select" id="to" name="to">
                {entries.map((entry) => (
                  <option value={entry.first_seen.label} selected={entry.first_seen.label === to}>
                    {entry.first_seen.label}
                  </option>
                ))}
              </select>
            </div>
            <button class="usa-button picker__go" type="submit">
              Diff
            </button>
          </form>
        )}

        <div class="diff-view diff-view--text" set:html={diffLinesHtml(diff.lines)} />

        {/* The XML is still there for whoever wants it — this page just no
            longer makes everyone else read it (ADR-0026). It renders here now
            rather than only as a link to JSON, and it is a link rather than a
            `<details>` because the cost is in *computing* it: not rendering it
            is the saving, so the toggle has to be a round trip. */}
        <section class="sourcepanel">
          <h2 class="toc-group" id="source">Source XML</h2>

          {!source && (
            <p class="doc-meta">
              This redline is of what the section <em>says</em>. The same comparison of the
              verbatim USLM — every attribute, including the <code>@id</code> guids that
              regenerate at every release point — is{" "}
              <a
                href={`${sourceToggleHref(true)}#source`}
                rel="nofollow"
                data-source-render
              >available as a source redline</a>. It is computed only when you ask for it,
              because it is expensive to produce.
            </p>
          )}

          {source && (
            <>
              <p class="doc-meta">
                The verbatim USLM, redlined.{" "}
                {source.inserted === 0 && source.deleted === 0
                  ? "The two fragments are byte-for-byte identical."
                  : `${source.inserted.toLocaleString()} characters added, ${source.deleted.toLocaleString()} removed — most of it is usually @id churn, not legal change.`}{" "}
                <a href={`${sourceToggleHref(false)}#source`} rel="nofollow">Hide it</a>, or take
                it as{" "}
                <a href={apiDiffHref(identifier, from ?? "", to ?? "")}>JSON from the API</a>.
              </p>
              <div class="diff-view diff-view--source" set:html={source.html} />
            </>
          )}
        </section>

        {/* Asking for the source redline is a round trip that recomputes the
            expensive diff, so the click can sit for a second or two with
            nothing but the browser's own tab spinner to show for it. This is
            the only thing on the page that needs script: the links work
            without it, and this adds a "rendering…" line next to whichever one
            was clicked. Modified clicks (new tab, new window) open elsewhere,
            so they get no indicator on *this* page. */}
        <script is:inline>
          {
            for (const link of document.querySelectorAll("a[data-source-render]")) {
              link.addEventListener("click", (event) => {
                if (
                  event.defaultPrevented ||
                  event.button !== 0 ||
                  event.metaKey ||
                  event.ctrlKey ||
                  event.shiftKey ||
                  event.altKey ||
                  link.dataset.rendering === "1"
                ) {
                  return;
                }
                link.dataset.rendering = "1";
                link.setAttribute("aria-busy", "true");
                const status = document.createElement("p");
                status.className = "sourceload";
                // `role="status"` rather than a bare span: the wait is the
                // message, and a reader who cannot see the spinner still needs
                // to be told the click did something.
                status.setAttribute("role", "status");
                status.innerHTML =
                  '<span class="sourceload__spin" aria-hidden="true"></span>Rendering the source redline…';
                // Below the sentence the link sits in, not inside it: dropping
                // it after the anchor puts a spinner mid-clause.
                (link.closest("p") ?? link).insertAdjacentElement("afterend", status);
              });
            }
          }
        </script>
      </>
    )
  }
</Base>
