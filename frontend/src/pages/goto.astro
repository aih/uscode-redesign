---
/**
 * `/app/goto?q=…` — where the site's one search box lands, and the router that
 * decides what the box was asked for.
 *
 * There used to be two boxes in the header, and therefore two landing pages:
 * this one for citations and `/app/search` for words. That asked the reader to
 * classify their own question before typing it. Now there is one box, and the
 * classification happens here, in this order:
 *
 *   1. **`cites …`** — an explicit reverse-citation request. Answered for now
 *      by a keyword search over the subject, and marked as such on the results
 *      page so the answer is not mistaken for the real thing.
 *      `docs/citation-index-plan.md` is the index that makes it real.
 *   2. **Parses as a citation** — the original behaviour, unchanged. Redirect
 *      rather than render, for the same reason the `?id=` guid page does: what
 *      you end up looking at and what is in the address bar should agree, and
 *      the reader's URLs stay identifier-shaped. A 307 keeps the method and is
 *      not cached as permanent by a browser that saw one query once.
 *   3. **Does not parse** — words, so search them. This is the case that used
 *      to be a 404 with a list of accepted citation forms, which was the right
 *      answer for a box labelled "go to a citation" and the wrong one for a box
 *      that also searches.
 *
 * What still renders here is the *middle* failure, and it is the one worth
 * keeping a page for: a citation that parsed cleanly and names something this
 * database does not hold — including the appendix titles, which OLRC publishes
 * under the enacting law rather than a section number, and which the API
 * explains rather than 404s.
 */
import Base from "../layouts/Base.astro";
import CitationNotFound from "../components/CitationNotFound.astro";
import { ApiError, lookupCitation, releaseParams } from "../lib/api";
import { setNoStore } from "../lib/cache";
import { parseCites, parseHistory } from "../lib/query";
import type { Citation, Entry } from "../lib/types";
import { appHref, gotoHref, searchHref, versionsHref } from "../lib/url";

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const params = releaseParams(Astro.url);

// 1. An explicit "what cites this" — never a citation lookup, even though the
//    subject is written as one.
const cites = query ? parseCites(query) : null;
if (cites) {
  return Astro.redirect(searchHref(cites.subject, { cites: true }), 307);
}

// 1b. `history …` — the section's version history rather than its text
//     (ADR-0084), with an optional date range. The citation after the word
//     is still the API's to read; what this decides is where a section lands.
const history = query ? parseHistory(query) : null;

let found: Citation | null = null;
/** Why a `history` query rendered here instead of redirecting. */
let historyMessage: string | null = null;

if (query) {
  try {
    found = await lookupCitation(history ? history.subject : query, params);
  } catch (error) {
    // 3. Not a citation, so it was words. `citeparse` is the only thing that
    //    decides this (ADR-0023), which is why the fallback lives after the
    //    call rather than in a guess before it. A `history` query with no
    //    citation after it is not words either: it is told what it needs.
    if (error instanceof ApiError && error.status === 422) {
      if (!history) return Astro.redirect(searchHref(query), 307);
      historyMessage = `“${history.subject}” is not a citation. ${history.keyword} needs one: ${history.keyword} 16 usc 45f, or ${history.keyword} 16 usc 45f from 6/12/2026 to 7/12/2026.`;
    } else {
      throw error;
    }
  }
}

// 2. A citation that resolves.
if (found?.exists) {
  if (history && found.kind === "section") {
    return Astro.redirect(
      versionsHref(found.section_identifier, null, history.from ? history : null),
      307,
    );
  }
  if (history) {
    // A title or a chapter has no version history — sections are the storage
    // atom (ADR-0001) and the timeline is per section.
    historyMessage = `Version history is kept per section, and ${history.subject} is a ${found.kind === "title" ? "title" : "chapter or other subdivision"}. Open it and choose a section.`;
  } else {
    return Astro.redirect(appHref(found.identifier, params.release ?? null), 307);
  }
}

// Nothing below is cacheable: it is a rendering of one reader's failed attempt.
setNoStore(Astro.response.headers);
if (query) Astro.response.status = 404;

const EXAMPLES = [
  "11 usc 523",
  "11 U.S.C. § 523(a)(1)",
  "16 usc 45f(c)(5)",
  "section 523 of title 11",
  "42 USC 2000e-2",
  "11/523",
  "/us/usc/t11/s523",
  "11 usc ch. 5",
  "title 11",
  "cites 26 usc 501",
  "history 16 usc 2201",
  "history 16 usc 2201 from 6/12/2026 to 7/12/2026",
  "v 16/2201",
];

/** The trail out — Home › Search (ADR-0079). This page only renders on a
 * failure, and a failure page with no way back is worst in an installed
 * window, which has no browser back button. `current` keeps an empty
 * identifier so `PrintHeader` stays silent. */
const crumbs: Entry[] = [{ identifier: "/", level: "home", num: "Home", heading: null }];
const currentCrumb: Entry = { identifier: "", level: "page", num: "Search", heading: null };
---

<Base
  title={query ? `No match for ${query} · U.S. Code` : "Search the U.S. Code"}
  crumbs={crumbs}
  current={currentCrumb}
  searchValue={query}
>
  <h1 class="doc-title">Search or go to a citation</h1>

  {
    !query && (
      <p class="lede">
        Type a citation in almost any written form and you land on the provision. Type
        anything else and it searches the text. Prefix a citation with <code>history</code>, or
        <code>v</code>, to open its version history instead, with <code>from</code> and <code>to</code> dates if you
        want to know whether it changed between them.
      </p>
    )
  }

  {
    historyMessage && (
      <div class="usa-alert usa-alert--warning" role="alert">
        <div class="usa-alert__body">
          <h2 class="usa-alert__heading">No version history to open</h2>
          <p class="usa-alert__text">{historyMessage}</p>
          {found?.exists && (
            <p class="usa-alert__text">
              <a href={appHref(found.identifier, params.release ?? null)}>Open {history?.subject}</a>
            </p>
          )}
        </div>
      </div>
    )
  }

  {
    found && !found.exists && <CitationNotFound found={found} query={query} />
  }

  <p class="toc-group">Forms that work</p>
  <ul class="toc sitesearch__examples">
    {
      EXAMPLES.map((example) => (
        <li>
          <a href={gotoHref(example)}>
            <code>{example}</code>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="doc-meta">
    Subdivisions keep their case: <code>(B)</code> is not <code>(b)</code>. USLM identifiers
    distinguish them.
  </p>
</Base>
