---
/**
 * `/app/classification/ecct` — the Editorial Classification Change Table
 * (ADR-0067).
 *
 * Where a classification table row reads `ed chg` or `nt ed chg`, the provision
 * moved editorially rather than by a public law, and this is the table that says
 * where from and where to. It is 21 rows, so it is one page with no paging.
 *
 * All four columns are text. The two "Provision" columns are full public law
 * citation strings, verbatim from the source; the two classification columns
 * carry no `usc_identifier`, and this reader does not compose one — see `cell`.
 */
import Base from "../../layouts/Base.astro";
import ErrorPage from "../../components/ErrorPage.astro";
import { ApiError, fetchEcct } from "../../lib/api";
import { resultCitation } from "../../lib/cite";
import type { EcctPage } from "../../lib/types";
import { classificationHref } from "../../lib/url";

let page: EcctPage | null = null;
let failure: { status: number; detail: string } | null = null;

try {
  page = await fetchEcct();
} catch (error) {
  if (error instanceof ApiError) {
    failure = { status: error.status, detail: error.detail };
    Astro.response.status = error.status;
  } else {
    console.error("ECCT request failed", error);
    failure = {
      status: 503,
      detail: "The classification tables are unavailable right now. Please try again shortly.",
    };
    Astro.response.status = 503;
  }
}

const items = page?.items ?? [];

/**
 * One classification cell: the citation, and whether the source left it empty.
 *
 * Nothing here links into the reader. `ClassificationTable` links a row only
 * where the loader supplied a `usc_identifier`, and the ECCT carries none — so
 * a link here could only be composed from `title_num` and `section_norm`, which
 * is a guess about a provision this table exists to say has moved. Composing it
 * was measured against the running site: 7 of the 30 section links 404ed, every
 * one of them in the Former classification column.
 *
 * Four of the 21 rows have no former classification at all — a note that was
 * newly classified rather than moved — so the cell needs a rendering for
 * nothing, as every cell in `ClassificationTable` does.
 */
function cell(
  titleNum: string | null,
  sectionNorm: string | null,
  raw: string,
  isNote: boolean,
): string | null {
  const cite = resultCitation(titleNum, sectionNorm ? `§ ${sectionNorm}` : null, "section");
  const text = cite ?? raw.trim();
  if (!text) return null;
  return isNote ? `${text} note` : text;
}
---

<Base title="Editorial Classification Change Table · U.S. Code" wide>
  <h1 class="doc-title">Editorial Classification Change Table</h1>

  {failure && <ErrorPage status={failure.status} detail={failure.detail} />}

  {
    !failure && (
      <>
        <p class="lede">
          Provisions reclassified editorially rather than by a public law. A classification table
          row marked <code>ed chg</code> or <code>nt ed chg</code> points here.{" "}
          <a href={classificationHref()}>All classification tables</a>.
        </p>

        {items.length === 0 ? (
          <p>The Editorial Classification Change Table holds no rows.</p>
        ) : (
          <div
            class="uslm-tablewrap"
            role="region"
            tabindex="0"
            aria-label="Editorial classification changes"
          >
            <table class="usa-table usa-table--striped classtable">
              <caption>
                Editorial classification changes — {items.length.toLocaleString()} rows
              </caption>
              <thead>
                <tr>
                  <th scope="col">Former classification</th>
                  <th scope="col">New classification</th>
                  <th scope="col">Provision affected</th>
                  <th scope="col">Provision prompting the change</th>
                </tr>
              </thead>
              <tbody>
                {items.map((entry) => {
                  const former = cell(
                    entry.former_title_num,
                    entry.former_section_norm,
                    entry.former_raw,
                    entry.former_is_note,
                  );
                  const next = cell(
                    entry.new_title_num,
                    entry.new_section_norm,
                    entry.new_raw,
                    entry.new_is_note,
                  );
                  return (
                    <tr>
                      <th scope="row" class="classtable__cite">
                        {former == null ? (
                          <span
                            class="classtable__none"
                            aria-label="Newly classified, moved from nothing"
                          >
                            —
                          </span>
                        ) : (
                          former
                        )}
                      </th>
                      <td class="classtable__cite">
                        {next == null ? <span class="classtable__none">—</span> : next}
                      </td>
                      <td>{entry.provision_affected}</td>
                      <td>{entry.provision_prompting}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </>
    )
  }
</Base>
