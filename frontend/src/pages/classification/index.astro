---
/**
 * `/app/classification` — OLRC's classification tables (ADR-0067).
 *
 * The tables record which provision of which public law was classified to which
 * US Code section. This page is the way in: the lookup box, the session OLRC is
 * currently adding to, and every table the site holds.
 *
 * `?q=` is the lookup's no-script path. The query is answered by
 * `/api/v1/classifications/suggest`, the same endpoint the island calls, so
 * both paths get the same parse — this page renders the answers as links
 * instead of as a listbox.
 *
 * The freshness line here is the classification source's, from
 * `classification_source_checks`. It is deliberately not `/api/v1/status`,
 * which reports how current the *corpus* is: the two sources are polled
 * separately and a page that borrowed the other's answer would state a fact
 * about the wrong thing (ADR-0067 decision 4).
 *
 * `?title=` and `?section=` are the third thing this route does. A lookup that
 * reads a US Code citation offers "Public laws that affected § …", and what
 * that leads to is every row ever classified to that section, across every
 * table — which is this page with the two filters on. It is not a route of its
 * own because it is one query answered in the place the query is typed.
 *
 * `?title=` **without** a section is the same view a title wide: every row
 * classified anywhere in title 15, which is what `15 usc` and `title 15` ask
 * for. A section number still names nothing without its title, so the pair is
 * ordered rather than symmetric — dropping the title drops both.
 *
 * The section view also says what it cannot show. The tables begin at the 104th
 * Congress, and the section's notes in the reader carry OLRC's own
 * classification history further back than that, so the view links them. The
 * link is built from a `/api/v1/citation` lookup rather than from the title and
 * section in hand, because the corpus spells a section number with an EN DASH
 * and typed input carries a hyphen (gotcha 17) — and because a section that is
 * not in the Code should be offered no link at all.
 */
import Base from "../../layouts/Base.astro";
import ClassificationLookup from "../../components/ClassificationLookup.astro";
import ClassificationMatches from "../../components/ClassificationMatches.astro";
import ClassificationTable from "../../components/ClassificationTable.astro";
import ErrorPage from "../../components/ErrorPage.astro";
import {
  ApiError,
  CLASSIFICATION_PAGE_SIZE,
  fetchClassificationSuggestions,
  fetchClassificationTables,
  fetchClassificationsForSection,
  fetchClassificationsForTitle,
  lookupCitation,
} from "../../lib/api";
import { classificationNote } from "../../lib/currency";
import { resultCitation } from "../../lib/cite";
import { NOTES_ANCHOR } from "../../lib/uslm";
import type {
  ClassificationEntryPage,
  ClassificationFile,
  ClassificationSuggestion,
  ClassificationTables,
} from "../../lib/types";
import {
  appHref,
  classificationEcctHref,
  classificationHref,
  classificationScopeValue,
  normalizeSectionKey,
  parseClassificationScope,
  readOffset,
} from "../../lib/url";

/** Strip `scope=` when the form submitted an empty value (the "Every table"
 *  option). The select always posts its value; an empty one means no scope and
 *  belongs in a clean URL without the param.
 *
 *  The target is a path, never `Astro.url` with a parameter removed: the Node
 *  adapter only trusts a request's `Host` when `security.allowedDomains` names
 *  it, and with that unset it falls back to the literal `localhost` with no
 *  port. So `Astro.url.origin` is `http://localhost` behind this deployment's
 *  proxy, and an absolute redirect built from it sends the browser to port 80. */
if (Astro.url.searchParams.get("scope") === "") {
  const rest = new URLSearchParams(Astro.url.searchParams);
  rest.delete("scope");
  const remaining = rest.toString();
  return Astro.redirect(
    remaining ? `${classificationHref()}?${remaining}` : classificationHref(),
    302,
  );
}

const query = (Astro.url.searchParams.get("q") ?? "").trim();
/** `?scope=118-2` narrows the lookup to one table — the select's no-script
 *  round trip. A value naming no table scopes nothing. */
const scope = parseClassificationScope(Astro.url.searchParams.get("scope"));
const titleFilter = Astro.url.searchParams.get("title")?.trim().toLowerCase() || null;
const rawSection = Astro.url.searchParams.get("section")?.trim() || null;
const sectionFilter = rawSection ? normalizeSectionKey(rawSection) : null;
/** A title, and a section within it when one was named. A section number names
 *  nothing without its title, so the section alone is ignored. */
const byCode = titleFilter ? { titleFilter, sectionFilter } : null;

let data: ClassificationTables | null = null;
let failure: { status: number; detail: string } | null = null;

try {
  data = await fetchClassificationTables();
} catch (error) {
  if (error instanceof ApiError) {
    failure = { status: error.status, detail: error.detail };
    Astro.response.status = error.status;
  } else {
    console.error("classification tables request failed", error);
    failure = {
      status: 503,
      detail: "The classification tables are unavailable right now. Please try again shortly.",
    };
    Astro.response.status = 503;
  }
}

const suggestions: ClassificationSuggestion[] = query
  ? await fetchClassificationSuggestions(query, scope)
  : [];

/** Which page of the by-code view. Only that view is paged — the registry
 *  under it is 33 rows and whole. */
const sectionOffset = readOffset(Astro.url.searchParams.get("offset"));

/** The by-code view never fails this page: the registry below it is the
 *  answer to a different question and is still worth showing. */
let sectionRows: ClassificationEntryPage | null = null;
if (byCode && !failure) {
  const paging = { limit: CLASSIFICATION_PAGE_SIZE, offset: sectionOffset };
  sectionRows = byCode.sectionFilter
    ? await fetchClassificationsForSection(
        byCode.titleFilter,
        byCode.sectionFilter,
        paging,
      ).catch(() => null)
    : await fetchClassificationsForTitle(byCode.titleFilter, paging).catch(() => null);
}
const sectionCitation = byCode
  ? resultCitation(
      byCode.titleFilter,
      byCode.sectionFilter ? `§ ${byCode.sectionFilter}` : null,
      "section",
    )
  : null;

/** Where the reader prints what the tables cannot: OLRC's own classification
 *  history, in the section's notes, which reach back past the 104th Congress.
 *
 *  Resolved rather than assembled — `/api/v1/citation` answers with the
 *  spelling the corpus holds (an EN DASH where the tables write a hyphen) and
 *  with whether the section is in the Code at all. A section that is not gets
 *  no link. */
let notesTarget: { href: string; citation: string; heading: string | null } | null = null;
if (byCode?.sectionFilter && !failure) {
  const resolved = await lookupCitation(
    `${byCode.titleFilter} usc ${byCode.sectionFilter}`,
  ).catch(() => null);
  if (resolved?.exists) {
    notesTarget = {
      href: `${appHref(resolved.section_identifier)}#${NOTES_ANCHOR}`,
      // `num` is the source's own — `§ 45f.`, section symbol and trailing
      // period included. The symbol is why it is passed through rather than
      // rebuilt from the number typed; the period is dropped, because this
      // citation sits inside a sentence rather than at the head of a row.
      citation:
        resultCitation(
          resolved.title_num,
          resolved.num?.replace(/\.$/u, "") ?? `§ ${byCode.sectionFilter}`,
          "section",
        ) ?? resolved.section_identifier,
      heading: resolved.heading,
    };
  }
}

/** The filters in force, each with the same view minus itself — the same pills
 *  the session page renders. Dropping the section keeps the title, which is a
 *  view of its own; dropping the title drops both, since a section number names
 *  nothing without one. */
const sectionFilters = byCode
  ? [
      { name: "Title", label: byCode.titleFilter, href: classificationHref() },
      ...(byCode.sectionFilter
        ? [
            {
              name: "Section",
              label: byCode.sectionFilter,
              href: classificationHref(null, null, { title: byCode.titleFilter }),
            },
          ]
        : []),
    ]
  : [];

/** The same view at another page, keeping the filters. */
function sectionPageHref(nextOffset: number): string {
  return classificationHref(null, null, {
    title: byCode?.titleFilter,
    section: byCode?.sectionFilter,
    offset: nextOffset,
  });
}

const sectionTotal = sectionRows?.total ?? 0;
const sectionItems = sectionRows?.items ?? [];
/** An offset past the last row: the request succeeded and named a page that is
 *  not there, which is a different thing from a section with no rows. */
const sectionPastEnd = sectionTotal > 0 && sectionOffset >= sectionTotal;
const sectionFrom = sectionItems.length > 0 ? sectionOffset + 1 : 0;
const sectionTo = sectionOffset + sectionItems.length;

const files = (data?.files ?? []).filter((file) => file.kind === "pl");
const ecctFiles = (data?.files ?? []).filter((file) => file.kind === "ecct");

/** The API returns the registry newest first already; `current` is its own
 *  field rather than this page's guess at which row is newest. */
const ordered = files;
const current = data?.current ?? null;

const totalRows = data?.entry_total ?? 0;

/** How current the registry is, in the shape `/app/` gives the corpus's own
 *  poll: never checked, the last check failed, and a check older than the
 *  schedule intends are three sentences rather than one (`lib/currency.ts`). */
const note = classificationNote(data?.source ?? null);

/** "Public Laws 118-3 through 118-158", or the verbatim covered text where the
 *  source wrote one with a gap in it. */
function coverage(file: ClassificationFile): string {
  if (file.covered_laws_text) return file.covered_laws_text;
  if (file.covered_ranges.length > 0) {
    return file.covered_ranges.map((range) => `${file.congress}-${range}`).join(", ");
  }
  return "—";
}

function sessionName(file: ClassificationFile): string {
  return file.session === 0 ? "Whole congress" : `Session ${file.session}`;
}

/** The scope select's options — one per table, in the registry's own order
 *  (newest first). */
const scopeOptions = files.map((file) => ({
  value: classificationScopeValue(file.congress, file.session_label),
  label: `${ordinal(file.congress)} Congress, ${sessionName(file).toLowerCase()}`,
}));
const scopeValue = scope ? classificationScopeValue(scope.congress, scope.session) : "";

function usDate(iso: string | null): string {
  if (!iso) return "—";
  const [year, month, day] = iso.slice(0, 10).split("-");
  return year && month && day ? `${month}/${day}/${year}` : iso;
}

/** `104` → `104th`, `101` → `101st`. The tables run from the 104th, all of
 *  which take `th`, but a helper that only works on the data in hand is a
 *  helper that breaks when the source adds a row. */
function ordinal(n: number): string {
  const tens = n % 100;
  if (tens >= 11 && tens <= 13) return `${n}th`;
  return `${n}${["th", "st", "nd", "rd"][n % 10] ?? "th"}`;
}
---

{/* `wide` because the tables below are five and four columns. At 64em and up
    that is `--measure` plus 18rem; under it the measure is unchanged and the
    tables scroll inside their own region. */}
<Base title="Classification tables · U.S. Code" wide>
  {/* `ErrorPage` carries its own `<h1>`, so this one is rendered only when there
      is a page to title. Both together read as a heading over a table that is
      not there. */}
  {!failure && <h1 class="doc-title">Classification tables</h1>}

  {failure && <ErrorPage status={failure.status} detail={failure.detail} />}

  {
    !failure && (
      <>
        <p class="lede">
          Which provision of which public law was classified to which section of the Code. OLRC
          publishes one table per congress per session, in public law order;{" "}
          {totalRows.toLocaleString()} rows across {files.length} tables are held here.
        </p>

        <ClassificationLookup value={query} scopeOptions={scopeOptions} scopeValue={scopeValue} />

        {query && <ClassificationMatches query={query} suggestions={suggestions} />}

        {byCode && (
          <section class="classsection" aria-labelledby="classsection-heading">
            <div class="filterpills">
              <span class="filterpills__label" id="classsection-pills">
                Filtered by
              </span>
              <ul class="filterpills__list" aria-labelledby="classsection-pills">
                {sectionFilters.map((filter) => (
                  <li>
                    <span class="filterpills__pill">
                      <span class="filterpills__name">{filter.name}</span>
                      <span class="filterpills__value">{filter.label}</span>
                      <a
                        class="filterpills__clear"
                        href={filter.href}
                        aria-label={`Remove the ${filter.name.toLowerCase()} filter ${filter.label}`}
                      >
                        <span aria-hidden="true">×</span>
                      </a>
                    </span>
                  </li>
                ))}
              </ul>
              <a class="filterpills__all" href={classificationHref()}>
                Clear all
              </a>
            </div>

            <h2 class="toc-group" id="classsection-heading">
              {sectionTotal === 0
                ? `Nothing was classified to ${sectionCitation}`
                : `${sectionTotal.toLocaleString()} row${
                    sectionTotal === 1 ? "" : "s"
                  } classified to ${sectionCitation}`}
            </h2>

            {/* What this view cannot show, said where the gap is: the tables
                begin at the 104th Congress and the notes do not. Rendered
                whether or not there are rows — an empty table is exactly when
                the reader needs the other route, and it is the only sentence
                that explains an empty one. */}
            <p class="doc-meta classsection__notes">
              The classification tables begin at the 104th Congress (1996).{" "}
              {!byCode.sectionFilter ? (
                <>
                  {/* One line: a break before the full stop survives the
                      compiler and the sentence ends " ." */}
                  <a href={appHref(`/us/usc/t${byCode.titleFilter}`)}>{sectionCitation} in the reader</a>.
                </>
              ) : notesTarget ? (
                <>
                  OLRC's notes for {notesTarget.citation} reach further back —{" "}
                  <a href={notesTarget.href}>read them in the reader</a>
                  {notesTarget.heading && <> ({notesTarget.heading})</>}.
                </>
              ) : (
                <>
                  A section's notes in the reader reach further back; this one is not in the Code
                  as it now stands.
                </>
              )}
            </p>

            {sectionPastEnd && (
              <p>
                That is past the last of {sectionTotal.toLocaleString()} rows.{" "}
                <a href={sectionPageHref(0)}>Back to the first page</a>.
              </p>
            )}

            {sectionItems.length > 0 && (
              <>
                <p class="doc-meta">
                  Newest public law first, across every table. Showing{" "}
                  {sectionFrom.toLocaleString()}–{sectionTo.toLocaleString()} of{" "}
                  {sectionTotal.toLocaleString()}.
                </p>
                <ClassificationTable
                  entries={sectionItems}
                  caption={`Classified to ${sectionCitation}, rows ${sectionFrom.toLocaleString()}–${sectionTo.toLocaleString()}`}
                />
              </>
            )}

            {!sectionPastEnd &&
              (sectionOffset > 0 || sectionTotal > sectionOffset + CLASSIFICATION_PAGE_SIZE) && (
                <nav class="searchpager" aria-label="Classification rows pages">
                  {sectionOffset > 0 && (
                    <a
                      class="usa-button usa-button--outline"
                      href={sectionPageHref(Math.max(0, sectionOffset - CLASSIFICATION_PAGE_SIZE))}
                    >
                      ← Previous
                    </a>
                  )}
                  {sectionTotal > sectionOffset + CLASSIFICATION_PAGE_SIZE && (
                    <a
                      class="usa-button usa-button--outline"
                      href={sectionPageHref(sectionOffset + CLASSIFICATION_PAGE_SIZE)}
                    >
                      Next →
                    </a>
                  )}
                </nav>
              )}
          </section>
        )}

        {note &&
          (note.tone === "warning" ? (
            <div class="usa-alert usa-alert--warning usa-alert--slim" role="status">
              <div class="usa-alert__body">
                <p class="usa-alert__text">
                  {note.text}
                  {note.detail && ` ${note.detail}`}
                </p>
              </div>
            </div>
          ) : (
            <p class="doc-meta source-currency" role="status">
              {note.text}
              {note.detail && <span class="source-currency__detail"> {note.detail}</span>}
            </p>
          ))}

        {current && (
          <section class="classcurrent" aria-labelledby="classcurrent-heading">
            <h2 class="toc-group" id="classcurrent-heading">
              Currently being classified
            </h2>
            <p>
              <a href={classificationHref(current.congress, current.session_label)}>
                {ordinal(current.congress)} Congress, {sessionName(current).toLowerCase()}
              </a>{" "}
              — {current.row_count.toLocaleString()} rows covering {coverage(current)}.
            </p>
            <p class="doc-meta">
              Prepared by the Office of the Law Revision Counsel {usDate(current.prepared_date)}.
              The current session's table is republished as new laws are classified.
            </p>
          </section>
        )}

        <h2 class="toc-group" id="classindex-heading">Every table</h2>
        <div
          class="uslm-tablewrap"
          role="region"
          tabindex="0"
          aria-labelledby="classindex-heading"
        >
          <table class="usa-table usa-table--striped classindex">
            <caption>Classification tables, newest first</caption>
            <thead>
              <tr>
                <th scope="col">Congress</th>
                <th scope="col">Session</th>
                <th scope="col">Public laws covered</th>
                <th scope="col">Rows</th>
                <th scope="col">Prepared</th>
              </tr>
            </thead>
            <tbody>
              {ordered.map((file) => (
                <tr>
                  <th scope="row">
                    <a href={classificationHref(file.congress, file.session_label)}>
                      {ordinal(file.congress)}
                    </a>
                  </th>
                  <td>{sessionName(file)}</td>
                  <td>{coverage(file)}</td>
                  <td class="classindex__count">{file.row_count.toLocaleString()}</td>
                  <td>{usDate(file.prepared_date)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="toc-group">Editorial Classification Change Table</h2>
        <p>
          A row marked <code>ed chg</code> or <code>nt ed chg</code> was reclassified editorially
          rather than by a public law. <a href={classificationEcctHref()}>The ECCT</a> records
          those moves — {ecctFiles.reduce((sum, file) => sum + file.row_count, 0)} rows.
        </p>
      </>
    )
  }
</Base>
