---
/**
 * `/app/us/usc/?id=idXXXX` — the guid form of a citation, in a browser.
 *
 * A guid pins (provision, release point) on its own (ADR-0003), so it needs no
 * release parameter and resolves to exactly one page. It redirects there rather
 * than rendering in place, because the reader's own URLs stay identifier-shaped:
 * what you end up looking at, and what is in the address bar, agree.
 */
import Base from "../../../layouts/Base.astro";
import ErrorPage from "../../../components/ErrorPage.astro";
import { API } from "../../../lib/url";
import { appHref } from "../../../lib/url";

const guid = Astro.url.searchParams.get("id");
const base = process.env.API_BASE_URL ?? "http://localhost:8000";

let detail = "Add ?id=… to look a provision up by its XML @id.";
let status = 400;

if (guid) {
  const response = await fetch(`${base}${API}/us/usc/?id=${encodeURIComponent(guid)}`, {
    headers: { accept: "application/json" },
  });
  if (response.ok) {
    const found = (await response.json()) as { identifier: string; release: { label: string } };
    return Astro.redirect(appHref(found.identifier, found.release.label), 307);
  }
  status = response.status;
  detail = `No provision has the @id ${guid}.`;
}

Astro.response.status = status;
---

<Base title={`${status} · U.S. Code`}>
  <ErrorPage status={status} detail={detail} />
</Base>
