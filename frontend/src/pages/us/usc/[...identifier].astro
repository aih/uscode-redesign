---
/**
 * `/app/us/usc/…` — a section with the named provision highlighted, or, when the
 * identifier names a structural node, that node's table of contents.
 *
 * The identifier decides which, and the API decides for us: one call answers with
 * a section or a TOC, so the reader does not have to know what `/us/usc/t16/ch1`
 * is before asking (the same design the API itself follows).
 *
 * Everything is fetched server-side and rendered to HTML. The page ships no
 * client JavaScript.
 */
import Base from "../../../layouts/Base.astro";
import ErrorPage from "../../../components/ErrorPage.astro";
import ApparatusDisclosure from "../../../components/ApparatusDisclosure.astro";
import ChapterRail from "../../../components/ChapterRail.astro";
import CitePreview from "../../../components/CitePreview.astro";
import CopyColumn from "../../../components/CopyColumn.astro";
import Neighbors from "../../../components/Neighbors.astro";
import SectionContents from "../../../components/SectionContents.astro";
import StatusBadge from "../../../components/StatusBadge.astro";
import WatchButton from "../../../components/WatchButton.astro";
import {
  ApiError,
  fetchIdentifier,
  fetchLabels,
  fetchNeighbors,
  fetchToc,
  releaseParams,
} from "../../../lib/api";
import { REVALIDATE, setPublicCache } from "../../../lib/cache";
import { ACCOUNTS_ENABLED } from "../../../lib/features";
import { sectionCommands } from "../../../lib/palette";
import { cachedReleases } from "../../../lib/releasecache";
import { citedIdentifiers } from "../../../lib/refs";
import type {
  Entry,
  Labels,
  Neighbors as NeighborsBody,
  Release,
  Section,
  Toc,
} from "../../../lib/types";
import { isToc } from "../../../lib/types";
import {
  apiHref,
  appHref,
  citationHref,
  provisionLabel,
  trimNum,
  versionsHref,
} from "../../../lib/url";
import type { OutlineEntry } from "../../../lib/uslm";
import { copyableIdentifiers, hrefs, outline, parseFragment, render } from "../../../lib/uslm";

/** Name the subdivisions after what they actually are: a title lists chapters, a
 * chapter lists subchapters, and USLM 2.x titles have subtitles. */
function subdivisionLabel(children: Entry[]): string {
  const levels = new Set(children.map((child) => child.level));
  if (levels.size !== 1) return "Subdivisions";
  const [level] = [...levels];
  return `${level.charAt(0).toUpperCase()}${level.slice(1)}s`;
}

const identifier = `/us/usc/${Astro.params.identifier ?? ""}`.replace(/\/+$/u, "");
const params = releaseParams(Astro.url);

let body: Section | Toc | null = null;
let failure: { status: number; detail: string } | null = null;
try {
  body = await fetchIdentifier(identifier, params);
} catch (error) {
  if (error instanceof ApiError) {
    failure = { status: error.status, detail: error.detail };
    Astro.response.status = error.status;
  } else {
    throw error;
  }
}

// --- everything below only runs when the identifier resolved -----------------

let title = "Not found · U.S. Code";
let crumbs: Entry[] = [];
let releases: Release[] = [];
let selected = "";
let neighbors: NeighborsBody | null = null;
/** The parent subdivision's table of contents, which feeds the `ChapterRail`.
 *  Null when the section has no parent, or when the call failed. */
let parentToc: Toc | null = null;
let labels: Labels = {};
let sectionHtml = "";
/** One rendered body per further occurrence the source published under this same
 *  identifier — normally empty (ADR-0021). */
let duplicateHtml: string[] = [];
let toc: Toc | null = null;
let section: Section | null = null;
let titleNum: string | null = null;
/** Every provision the copy column offers a control for — computed from the
 *  same parsed fragment the page renders, never from the emitted HTML. */
let copyTargets: string[] = [];
/** The section's own contents — its top-level provisions, then its source
 *  credit and notes. Same fragment, a third pass over it. */
let contents: OutlineEntry[] = [];

if (body && isToc(body)) {
  toc = body;
  selected = toc.served_from.label;
  titleNum = toc.node.identifier.match(/^\/us\/usc\/t([0-9]+[a-zA-Z]?)/u)?.[1] ?? null;
  crumbs = toc.ancestors;
  // A table of contents is structural, and `structure_nodes` holds one row per
  // node rather than one per release point (ADR-0006), so it revalidates rather
  // than being pinned even when the URL named a release point.
  Astro.response.headers.set("Cache-Control", REVALIDATE);
  releases = await cachedReleases(titleNum);
  title = `${trimNum(toc.node.num)} ${toc.node.heading ?? ""} · ${selected} · U.S. Code`;
} else if (body) {
  section = body;
  selected = section.served_from.label;
  titleNum = section.title_num;

  // The fragment is parsed once and used twice: to collect the citations it
  // makes, and — after their labels come back — to render. Two passes over a
  // parsed tree, never two parses.
  const fragment = parseFragment(section.xml);
  // The source repeats a few identifiers at the same release point; each extra
  // occurrence is a full section body and is rendered like the first, so its
  // citations must join the same batched label lookup — one request for the
  // page, not one per occurrence.
  const dupFragments = (section.duplicates ?? []).map((d) => parseFragment(d.xml));

  // Four calls, all server-side and all on localhost: the labels this page's
  // citations need (batched, `fetchLabels`), the neighbours, the release points
  // a picker can offer, and the parent's table of contents.
  //
  // Three of them reach the API every time. The release points usually do not:
  // `cachedReleases` holds one answer per title for five minutes, because the
  // list is the same for every section of a title and changes only when the
  // ingest chain loads something (ADR-0045). It was the slowest of these four
  // at 27.0 ms, so it set the whole group's cost; it is now a hit.
  //
  // The parent TOC is the call this page dropped in Day 6b, when the breadcrumb
  // moved onto the section itself and only two fields of a whole TOC were still
  // wanted. ADR-0043 puts it back and spends the whole of it: it is the
  // `ChapterRail`, which is a use for the sections list rather than for two
  // fields of the node.
  //
  // The labels are one of two calls allowed to fail. They are hover text over
  // citations that are already links, and the section's own words are in hand
  // before this runs — so losing them costs a tooltip, while `Promise.all`
  // rejecting costs the reader the statute. 3 U.S.C. § 301 is where that bill
  // came due: 242 cross references, one over-long request, 422, and a page
  // that 500ed with its text sitting in memory. The parent TOC is the other,
  // for the same reason: without it the reader loses the rail and still has the
  // section, the sticky bar and the neighbours.
  [labels, neighbors, releases, parentToc] = await Promise.all([
    fetchLabels(
      citedIdentifiers([fragment, ...dupFragments].flatMap((f) => hrefs(f))),
      selected,
    ).catch((error) => {
      console.error(`labels for ${section.identifier} at ${selected}:`, error);
      return {};
    }),
    fetchNeighbors(section.identifier, selected),
    cachedReleases(titleNum),
    section.parent_identifier
      ? fetchToc(section.parent_identifier, selected).catch((error) => {
          console.error(`rail for ${section.identifier} at ${selected}:`, error);
          return null;
        })
      : Promise.resolve(null),
  ]);

  crumbs = section.ancestors ?? [];
  // Same rule as the API (lib/cache.ts): forever only if this URL named a
  // release point and got it. The page itself is identical for every reader —
  // the Watch button is a client-side island — so `public` is safe here.
  setPublicCache(Astro.response.headers, params.release, section.is_exact);
  const renderOptions = {
    target: identifier === section.identifier ? null : identifier,
    release: selected,
    labels,
  };
  // `anchors` names the source credit and the notes so `SectionContents` has
  // somewhere to link to, and is passed for the first occurrence only: a
  // fragment name has to be unique in the page, and a further occurrence
  // (ADR-0021) is a second full section body in the same document.
  sectionHtml = render(fragment, { ...renderOptions, anchors: true });
  duplicateHtml = dupFragments.map((f) => render(f, renderOptions));
  copyTargets = copyableIdentifiers(fragment);
  contents = outline(fragment);
  title = `${trimNum(section.num)} ${section.heading ?? ""} · ${selected} · U.S. Code`;
}

const remainder = section ? identifier.slice(section.identifier.length) : "";
/** The form posts back to the identifier that was *asked for*, not to the
 *  section that answered. Built from `section.identifier`, switching release on
 *  `/us/usc/t16/s45f/c/5` dropped the `/c/5` and landed on the whole section. */
const picker =
  releases.length > 0 && body
    ? { action: appHref(identifier), options: releases, selected }
    : null;
const upNode = crumbs.length > 0 ? crumbs[crumbs.length - 1] : null;
/** The last crumb: the thing on screen, unlinked. `ancestors` stops at the
 *  parent, so without this the trail names everything except the section. */
const currentCrumb: Entry | null = section
  ? {
      identifier: section.identifier,
      level: "section",
      num: section.num,
      heading: section.heading,
      status: section.status,
      is_section: true,
    }
  : toc
    ? toc.node
    : null;
/** The sticky row's contents (Day 7). Only a section gets one: a table of
 * contents has no reading order to step through, and its own breadcrumbs
 * already say where it is. */
const bar = section
  ? {
      num: section.num,
      heading: section.heading,
      status: section.status,
      previous: neighbors?.previous,
      next: neighbors?.next,
      up: upNode,
    }
  : null;

/** `fetchReleases` answers newest first, so the head of the list is the newest
 *  release point this title has. Used to decide whether the rail has to warn
 *  that its structure and the text on screen may be from different releases. */
const isNewest = releases.length === 0 || releases[0].label === selected;
/** The rail's own data. Only a section gets one: a table of contents already
 *  *is* the list a rail would show. */
const rail =
  section && parentToc && parentToc.sections.length > 0
    ? { parent: parentToc.node, entries: parentToc.sections }
    : null;

/** The command palette's per-page rows (ADR-0062): the redline against the
 *  previous release point, and this section's version history. Built from
 *  `releases`, which is already in hand for the release switcher, so neither
 *  costs a further call. A table of contents gets none — there is no section to
 *  compare and no timeline to show. */
const commands = section ? sectionCommands(section.identifier, releases, selected) : [];

/** The four facts about the text on screen (ADR-0044). `served_from` is the
 *  release point that actually answered, which is not always the one asked for
 *  (gotcha 10); `note` is the API's own sentence saying so. */
const served = section?.served_from ?? toc?.served_from ?? null;
const releaseContext = served
  ? {
      served,
      isNewest,
      newestHref: isNewest ? null : appHref(identifier),
      note: section?.note ?? toc?.note ?? null,
    }
  : null;
---

<Base
  title={title}
  crumbs={crumbs}
  current={currentCrumb}
  release={selected}
  releaseContext={releaseContext}
  picker={picker}
  bar={bar}
  commands={commands}
  rail={rail !== null}
>
  {
    rail && (
      <ChapterRail
        slot="rail"
        parent={rail.parent}
        entries={rail.entries}
        current={section!.identifier}
        release={selected}
        isNewest={isNewest}
      />
    )
  }

  {failure && <ErrorPage status={failure.status} detail={failure.detail} identifier={identifier} />}

  {
    section && (
      <>
        <h1 class="doc-title">
          <span class="doc-title__num">{trimNum(section.num)}.</span>
          {section.heading}
          <StatusBadge status={section.status} />
        </h1>

        <p class="doc-meta">
          <a href={versionsHref(section.identifier)}>
            Version history — every release point where this text changed
          </a>
        </p>

        {/* Same reasoning as the navbar's account control: an island that can
            only ever be told 401 is a request per page view for nothing. */}
        {ACCOUNTS_ENABLED && (
          <WatchButton identifier={section.identifier} release={selected} />
        )}

        {/* `NavStrip` used to sit here. Its prev/up/next moved into the sticky
            `SectionBar`, which carries them at every scroll position rather than
            only at the top — rendering both would show the same two links twice,
            a few pixels apart. `Neighbors` still closes the page. */}

        {remainder &&
          (section.provision?.found ? (
            <p class="doc-meta">
              Showing {provisionLabel(remainder)} in the context of the whole section.
            </p>
          ) : (
            <div class="usa-alert usa-alert--warning usa-alert--slim" role="status">
              <div class="usa-alert__body">
                <p class="usa-alert__text">
                  There is no {provisionLabel(remainder)} in this section at {selected}.
                </p>
              </div>
            </div>
          ))}

        {duplicateHtml.length > 0 && (
          <div class="usa-alert usa-alert--info" role="note">
            <div class="usa-alert__body">
              <h2 class="usa-alert__heading">
                This section appears more than once at this release point
              </h2>
              <p class="usa-alert__text">
                The official XML for this title at {selected} publishes{" "}
                {duplicateHtml.length + 1} distinct texts under the identifier{" "}
                <code>{section.identifier}</code>. Nothing in the source marks one
                of them as the authoritative version, so all{" "}
                {duplicateHtml.length + 1} are shown below, in the order they appear
                in the source — rather than one being chosen here.
              </p>
            </div>
          </div>
        )}

        {duplicateHtml.length > 0 && (
          <p class="doc-occurrence">Occurrence 1 of {duplicateHtml.length + 1}</p>
        )}

        {/* The section's own contents, above the text it indexes. A reader who
            has just arrived is at the top; what they cannot otherwise see from
            here is how long the section is, what its subsections are called,
            and that there is a source credit and a notes block at the end of
            it. */}
        <SectionContents entries={contents} />

        {/* Before the text, so the mode toggle is the first thing a reader
            meets rather than something found after scrolling past the controls
            it governs. The widget itself injects the per-provision buttons into
            the article below. */}
        <CopyColumn identifiers={copyTargets} release={selected} />

        <article class="section-body" set:html={sectionHtml} />

        {section.duplicates?.map((other, index) => (
          <>
            <p class="doc-occurrence">
              Occurrence {index + 2} of {duplicateHtml.length + 1}
              {other.heading && other.heading !== section!.heading && (
                <span class="doc-occurrence__heading"> — {other.heading}</span>
              )}
              <StatusBadge status={other.status} />
            </p>
            <article class="section-body" set:html={duplicateHtml[index]} />
          </>
        ))}

        <Neighbors previous={neighbors?.previous} next={neighbors?.next} release={selected} />

        {/* `KeyboardNav` used to sit here, bound to these same three
            neighbours. It is in `Base.astro` now and takes them from the `bar`
            prop, which is built from the same `neighbors` a few lines up. */}

        {/* One card for every citation in the text above (ADR-0024). Mounted
            only on a section page, because that is the only page that renders
            statutory text with references in it. */}
        {/* The notes and the source credit open and close for real, and the
            fragment a link or the keyboard map names opens on arrival
            (ADR-0060). After the article, so the elements it sets exist even if
            the browser runs it before `DOMContentLoaded`. */}
        <ApparatusDisclosure />

        <CitePreview />

        <p class="formats">
          <a href={apiHref(section.identifier, { release: selected, format: "xml" })}>
            Source XML
          </a>
          <a href={apiHref(section.identifier, { release: selected, format: "json" })}>JSON</a>
          <a href={`/api/v1/sections${section.identifier}/versions`}>Version history</a>
        </p>

        {section.guid && (
          <p class="formats">
            Cite this exact text:
            <a class="cite" href={`/us/usc/?id=${section.guid}`}>
              /us/usc/?id={section.guid}
            </a>
          </p>
        )}

        <p class="formats">
          Citation URL:
          <span class="cite">{citationHref(identifier, selected)}</span>
        </p>
      </>
    )
  }

  {
    toc && (
      <>
        <h1 class="doc-title">
          <span class="doc-title__num">{trimNum(toc.node.num)}</span>
          {toc.node.heading}
          <StatusBadge status={toc.node.status} />
        </h1>

        {toc.children.length === 0 && toc.sections.length === 0 && (
          <p class="lede">Nothing is listed under this node at {selected}.</p>
        )}

        {toc.children.length > 0 && (
          <>
            <p class="toc-group">{subdivisionLabel(toc.children)}</p>
            <ul class="toc">
              {toc.children.map((child) => (
                <li>
                  <a href={appHref(child.identifier, selected)}>
                    <span class="toc__num">{trimNum(child.num)}</span>
                    <span class="toc__heading">{child.heading}</span>
                    <StatusBadge status={child.status} />
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}

        {toc.sections.length > 0 && (
          <>
            <p class="toc-group">Sections</p>
            <ul class="toc">
              {toc.sections.map((entry) => (
                <li>
                  <a href={appHref(entry.identifier, selected)}>
                    <span class="toc__num">{trimNum(entry.num)}</span>
                    <span class="toc__heading">{entry.heading}</span>
                    <StatusBadge status={entry.status} />
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )
  }
</Base>

<script is:inline>
  // The one line of script in the reader, and it is not required to read the
  // page: bring a deep-linked provision into view when the browser has not.
  const target = document.querySelector(".target");
  if (target) target.scrollIntoView({ block: "center" });
</script>
