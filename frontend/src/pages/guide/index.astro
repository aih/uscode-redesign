---
/**
 * `/app/guide` — the way into the user guide (ADR-0038).
 *
 * An `.astro` page rather than a chapter, because it is a list of the chapters
 * and a chapter that listed itself would be odd. It wears the same layout so
 * the guide's chrome does not change when you enter it, and passes
 * `standalone` so that layout leaves off the chapter pager.
 */
import GuideLayout from "../../layouts/GuideLayout.astro";
import { chapters } from "../../lib/guide";

const CHAPTERS = chapters();
---

<GuideLayout
  standalone
  frontmatter={{
    title: "User guide",
    order: 0,
    summary:
      "How to use this site",
  }}>
  <p>
    This guide covers what the site does and how to use it to research the U.S. Code — reading a provision,
    finding the text at an earlier release point, comparing two versions, searching,
    copying, and using the API.
  </p>

  <p>
    Each behaviour described here carries a <strong>“How this is verified”</strong> box listing
    demonstration steps. Those steps run as automated tests on every change to the
    site, so the guide serves as both user documentation and automated QA.
  </p>

  <ul class="toc">
    {
      CHAPTERS.map((chapter) => (
        <li>
          <a href={chapter.href}>
            <span class="toc__num">{chapter.order}</span>
            <span class="toc__heading">{chapter.title}</span>
            {chapter.summary && <span class="doc-meta">{chapter.summary}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</GuideLayout>
