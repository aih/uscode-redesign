---
/**
 * `/app/search?q=…` — keyword results (ADR-0028).
 *
 * Reached from the header's one box by way of `/app/goto`, which routes here
 * whatever it cannot read as a citation, and directly by anyone who pastes the
 * URL. `?cites=1` marks a query that arrived as `cites <citation>`: a request
 * for the provisions that *cite* one, which this site cannot answer yet and
 * answers as a keyword search over the subject — said plainly on the page
 * rather than quietly substituted. `docs/citation-index-plan.md` is the index
 * that makes it real.
 *
 * The page used to call the API with a bare `fetch` and its own base URL, print
 * `e.message` from a failed Node fetch straight to the reader, and hardcode
 * colours that were unreadable in dark mode. All three are why it now goes
 * through `lib/api` and the ADR-0027 tokens like every other page.
 */
import Base from "../layouts/Base.astro";
import ErrorPage from "../components/ErrorPage.astro";
import NoResults from "../components/NoResults.astro";
import SearchFacets from "../components/SearchFacets.astro";
import SearchResult from "../components/SearchResult.astro";
import { ApiError, fetchSearch, releaseParams } from "../lib/api";
import { CITES_KEYWORD } from "../lib/query";
import type { SearchResponse } from "../lib/types";
import { gotoHref, searchHref, syntaxHref } from "../lib/url";

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const offset = Math.max(0, Number(Astro.url.searchParams.get("offset") ?? "0") || 0);
const params = releaseParams(Astro.url);
/** Set when the query arrived as `cites <citation>`. */
const asCites = Astro.url.searchParams.get("cites") === "1";

/** relevance, citation or recent. Anything else is treated as the default
 *  rather than passed on, so a mistyped URL gets a search rather than a 400. */
const SORTS = ["relevance", "citation", "recent"] as const;
const requested = Astro.url.searchParams.get("sort");
const sort = (SORTS as readonly string[]).includes(requested ?? "")
  ? (requested as string)
  : "relevance";

const SORT_LABELS: Record<string, string> = {
  relevance: "Relevance",
  citation: "Citation order",
  recent: "Recently amended",
};

/** One number, not the three hardcoded copies this page used to keep. It has to
 *  match what the API was asked for, since the pager does the arithmetic. */
const PAGE_SIZE = 20;

let data: SearchResponse | null = null;
let failure: { status: number; detail: string } | null = null;

if (query) {
  try {
    data = await fetchSearch(query, { offset, limit: PAGE_SIZE, sort, ...params });
  } catch (error) {
    if (error instanceof ApiError) {
      failure = { status: error.status, detail: error.detail };
      Astro.response.status = error.status;
    } else {
      // A transport failure stringifies to `connect ECONNREFUSED api:8001`,
      // which is this site's internals and not a reader's business.
      console.error("search request failed", error);
      failure = { status: 503, detail: "Search is unavailable right now. Please try again shortly." };
      Astro.response.status = 503;
    }
  }
}

/** Paging keeps the moment the search was made at, and the `cites` framing.
 *
 * Both halves of that moment: a search made with `?date=` used to lose it here,
 * so page one read the law as it stood at that date and page two read the law
 * in force — the same query, the same result count in the heading, different
 * text underneath. The line below the heading does change, which is the only
 * reason this was a quiet bug rather than a silent one. */
function pageHref(nextOffset: number): string {
  return searchHref(query, {
    cites: asCites,
    release: params.release,
    date: params.date,
    sort,
    offset: nextOffset,
  });
}

/** The same search under a different order. Everything else about the moment —
 *  the release, the `cites` framing — is kept; the offset is not, because page
 *  three of one ordering is not page three of another. */
function sortHref(next: string): string {
  return searchHref(query, {
    cites: asCites,
    release: params.release,
    date: params.date,
    sort: next,
  });
}

const total = data?.total ?? 0;
const results = data?.results ?? [];
const title = query ? `Search: ${query} · U.S. Code` : "Search · U.S. Code";
---

<Base title={title} searchValue={asCites ? `${CITES_KEYWORD} ${query}` : query}>
  <h1 class="doc-title">Search</h1>

  {failure && <ErrorPage status={failure.status} detail={failure.detail} />}

  {
    asCites && (
      <div class="usa-alert usa-alert--info usa-alert--slim" role="status">
        <div class="usa-alert__body">
          <p class="usa-alert__text">
            Showing a <strong>keyword search</strong> for <code>{query}</code>. Finding the
            provisions that <em>cite</em> it needs an index of every cross reference in the
            Code, and this site does not have one yet. This searches for the words instead.
            That finds a citation written out in text, but not one written as a link.
          </p>
        </div>
      </div>
    )
  }

  {
    !query && !failure && (
      <p class="lede">
        Search the text of the Code. A citation typed into the box above goes straight to
        the provision instead. <a href={gotoHref()}>The forms it accepts</a> are listed on
        the go-to page.
      </p>
    )
  }

  {
    query && !failure && (
      <>
        <h2 class="toc-group">
          {total === 0
            ? "No results"
            : `${total.toLocaleString()} result${total === 1 ? "" : "s"}`}{" "}
          for “{query}”
        </h2>

        <p class="doc-meta">
          {data?.release ? (
            <>
              In the text as of release point <strong>{data.release}</strong>.
            </>
          ) : (
            <>Searching the law currently in force.</>
          )}{" "}
          Words match as typed. <a href={syntaxHref()}>Operators</a> loosen that.
        </p>

        {total > 0 && (
          <nav class="sortbar" aria-label="Sort results">
            <span class="sortbar__label" id="sortbar-label">
              Order
            </span>
            <ul class="sortbar__list" aria-labelledby="sortbar-label">
              {SORTS.map((option) => (
                <li>
                  {option === sort ? (
                    <span class="sortbar__option sortbar__option--on" aria-current="true">
                      {SORT_LABELS[option]}
                    </span>
                  ) : (
                    <a class="sortbar__option" href={sortHref(option)}>
                      {SORT_LABELS[option]}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )}

        {data && total > 0 && (
          <SearchFacets
            facets={data.facets}
            query={query}
            release={params.release}
            date={params.date}
            sort={sort}
            total={total}
          />
        )}

        {data?.note && (
          <div class="usa-alert usa-alert--info usa-alert--slim" role="status">
            <div class="usa-alert__body">
              <p class="usa-alert__text">{data.note}</p>
            </div>
          </div>
        )}

        {total === 0 && <NoResults query={query} />}

        <ul class="toc searchresults">
          {results.map((result) => (
            <SearchResult result={result} release={params.release} />
          ))}
        </ul>

        {(offset > 0 || total > offset + PAGE_SIZE) && (
          <nav class="searchpager" aria-label="Search results pages">
            {offset > 0 && (
              <a class="usa-button usa-button--outline" href={pageHref(Math.max(0, offset - PAGE_SIZE))}>
                ← Previous
              </a>
            )}
            {total > offset + PAGE_SIZE && (
              <a class="usa-button usa-button--outline" href={pageHref(offset + PAGE_SIZE)}>
                Next →
              </a>
            )}
          </nav>
        )}
      </>
    )
  }
</Base>
