  <p class="spec__label">A release point that answered for another</p>

  <p>
    A request for a release point that was never loaded is answerable from the newest one at or
    before it, because the title did not change in between. The answer is right, and the release
    context says where it came from rather than letting the substitution pass unremarked.
  </p>

  <div class="spec">
    <ReleaseContext
      served={RP_OLD}
      isNewest={false}
      newestHref={appHref("/us/usc/t0/s1")}
      note="You asked for release point 119-101, which was never loaded here. Title 0 did not change between 119-99 and 119-101, so this is 119-99's text and is the text that was in force."
    />
  </div>

  <script is:inline>
    {
      /* The colour table, computed from what the page resolved.
       *
       * Reading `getComputedStyle` rather than a table of hexes is the whole
       * point: it reports the colour in force, in the theme in force, which is
       * the thing a token audit cannot see. The pairs and their requirements
       * are server-rendered into the rows; this fills in the last column.
       */
      const root = document.documentElement;

      function channel(v) {
        const c = v / 255;
        return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
      }

      /** `#rgb`, `#rrggbb` and `rgb()`/`rgba()` with alpha 1. Anything else —
       *  a translucent wash, a gradient — has no single ratio to state, and is
       *  reported as such rather than guessed at, the same way the Python
       *  checker skips it. */
      function rgb(value) {
        const text = String(value).trim();
        const hex = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(text);
        if (hex) {
          const d =
            hex[1].length === 3
              ? [...hex[1]].map((c) => c + c).join("")
              : hex[1];
          return [0, 2, 4].map((i) => parseInt(d.slice(i, i + 2), 16));
        }
        const fn = /^rgba?\(([^)]+)\)$/i.exec(text);
        if (fn) {
          const parts = fn[1].split(/[\s,/]+/).filter(Boolean).map(Number);
          if (parts.length === 3 || parts[3] === 1) return parts.slice(0, 3);
        }
        return null;
      }

      function luminance(parts) {
        const [r, g, b] = parts.map(channel);
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
      }

      function ratio(fg, bg) {
        const a = luminance(fg);
        const b = luminance(bg);
        return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
      }

      const token = (name) => getComputedStyle(root).getPropertyValue(name).trim();

      function paint() {
        for (const cell of document.querySelectorAll("[data-swatch-value]")) {
          cell.textContent = token(cell.dataset.swatchValue) || "unset";
        }

        for (const row of document.querySelectorAll("[data-pair-fg]")) {
          const cell = row.querySelector("[data-pair-result]");
          const fg = rgb(token(row.dataset.pairFg));
          const bg = rgb(token(row.dataset.pairBg));
          if (!fg || !bg) {
            cell.textContent = "not an opaque colour";
            cell.className = "";
            continue;
          }
          const value = ratio(fg, bg);
          const needs = row.dataset.pairNeeds ? Number(row.dataset.pairNeeds) : null;
          // Two decimals, matching what contrast.py rounds to, so the two
          // answers are comparable digit for digit.
          const shown = value.toFixed(2);
          cell.dataset.ratio = shown;
          if (needs === null) {
            cell.textContent = `${shown}:1`;
            cell.className = "pairs__deco";
            continue;
          }
          const passes = value >= needs;
          cell.textContent = `${shown}:1 ${passes ? "pass" : "FAIL"}`;
          cell.className = passes ? "pairs__pass" : "pairs__fail";
        }

        const sample = document.querySelector("[data-measure-sample]");
        const measureToken = document.querySelector("[data-measure-token]");
        const measureWidth = document.querySelector("[data-measure-width]");
        if (sample && measureToken && measureWidth) {
          measureToken.textContent = token("--measure") || "unset";
          measureWidth.textContent = `${Math.round(sample.getBoundingClientRect().width)}px`;
        }

        /* The density readout, on the same principle as the colour table:
         * what is in force, not what is declared. `--indent-step` and
         * `--measure` are read off the statutory text rather than off `<html>`,
         * because `ch` and the `calc()` only become a length where they are
         * used — the value on the root is the unresolved token text. */
        const body = document.querySelector(".section-body");
        const table = document.querySelector("[data-density-table]");
        if (body && table) {
          const text = getComputedStyle(body);
          const rung = document.querySelector(".section-body .prov");
          const wrap = document.querySelector(".reader-wrap");
          const fill = (selector, value) => {
            const cell = table.querySelector(selector);
            if (cell) cell.textContent = value;
          };
          fill("[data-density-value]", root.dataset.density || "comfortable (default)");
          fill("[data-density-size]", text.fontSize);
          fill("[data-density-leading]", text.lineHeight);
          fill("[data-density-gap]", token("--reading-gap") || "unset");
          fill(
            "[data-density-step]",
            rung ? getComputedStyle(rung).paddingLeft : "unset",
          );
          fill(
            "[data-density-measure]",
            wrap ? getComputedStyle(wrap).maxWidth : "unset",
          );
        }
      }

      paint();

      // The theme and the density are attributes on <html>, set by the header's
      // two toggles and by the pre-paint bootstrap. Watching them is what keeps
      // these tables honest without either toggle having to know this page
      // exists.
      new MutationObserver(paint).observe(root, {
        attributes: true,
        attributeFilter: ["data-theme", "data-density"],
      });

      // The measured column width is a fact about the viewport, so it changes
      // when the viewport does.
      window.addEventListener("resize", paint);
    }
  </script>
</Base>
