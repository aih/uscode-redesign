const SPECIMEN_AFTER = SPECIMEN_BEFORE.replace(
  "$5,000,000 for each of fiscal years\n      2024 through 2028.",
  "$7,500,000 for each of fiscal years\n      2024 through 2030.",
).replace(
  // Anchored on the paragraph it follows rather than on the subsection's close
  // tag, which every subsection has: the specimen grew a (c) and a (d) and the
  // added paragraph landed after the fee table.
  "expended.</content>\n    </paragraph>",
  `expended.</content>
    </paragraph>
    <paragraph identifier="/us/usc/t0/s1/b/3">
      <num value="3">(3)</num>
      <content>Not later than 1 year after each disbursement, the Secretary shall submit
      to Congress a report on amounts expended under this subsection.</content>
    </paragraph>`,
);

const specimen = parseFragment(SPECIMEN_AFTER);
const specimenHtml = render(specimen, {
  target: "/us/usc/t0/s1/b/1",
  release: null,
  labels: {},
