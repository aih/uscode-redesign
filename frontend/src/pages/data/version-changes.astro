---
/**
 * `/app/data/version-changes` — how this site classifies a version change, and
 * what the corpus turned out to contain (ADR-0074, ADR-0076, ADR-0077).
 *
 * ## It reaches no data
 *
 * The figures come from `src/data/version-changes.json`, a copy of
 * `docs/verification/version-changes.json` kept equal by `make
 * sync-verification` and `tests/versiondata.test.ts`. No API call, no database,
 * no release point — the same property `/app/design` has (ADR-0053), and for
 * the same payoff: `make shots` and the axe matrix treat the page as a fixed
 * target, and the guide's scenario can assert its content in CI, where the
 * fixture corpus is Title 16 at two release points and could never produce
 * these numbers.
 *
 * The copy is a copy because `docker-compose.prod.yml` builds the reader with
 * `build: ./frontend`, so nothing under `docs/` exists at image-build time.
 *
 * ## What is dated, and how
 *
 * Every count and share comes from the artifact, and `generated_at` is printed
 * beside them, so the numbers and the date they were true of move together.
 *
 * Since ADR-0077 the report carries the corpus's coverage — titles, release
 * points, the newest loaded release point and its currency date — so those four
 * facts are no longer written by hand here. An artifact written before that
 * lacks `coverage`, `attribution_by_kind` and `by_release`; the page renders the
 * hand-written sentence and omits the two tables until the report is
 * regenerated, and says nothing false in the meantime.
 *
 * ## The sort is server-side
 *
 * `?sort=` in `SortBar`'s vocabulary, resolved here, so a sorted table is
 * citable by its address alone and the page keeps a zero-JavaScript budget.
 * The four sortable column headings are the same control (ADR-0071), with
 * `aria-sort` on the one in force.
 */
import Base from "../../layouts/Base.astro";
import SortBar from "../../components/SortBar.astro";
import REPORT from "../../data/version-changes.json";
import { setPublicCache } from "../../lib/cache";
import { APP, versionDataHref } from "../../lib/url";
import {
  ATTRIBUTIONS,
  attributionRows,
  concentration,
  formatCount,
  formatShare,
  parseSort,
  shareOf,
  sortTitleRows,
  titleRows,
  topReleases,
  type SortKey,
  type VersionChangeReport,
} from "../../lib/versiondata";

/** Fixed markup with no per-reader content and no release point to pin it to. */
setPublicCache(Astro.response.headers, null, false);

const report = REPORT as unknown as VersionChangeReport;
const rows = titleRows(report);
const sort = parseSort(Astro.url.searchParams.get("sort"));
const sorted = sortTitleRows(rows, sort);

const activeKey = sort.replace(/-desc$/u, "") as SortKey;
const descending = sort.endsWith("-desc");

const SORT_OPTIONS = [
  { key: "title", label: "Title", ascending: "Code order", descending: "reversed" },
  { key: "rows", label: "Change rows", ascending: "most first", descending: "fewest first" },
  { key: "text", label: "Text changes", ascending: "most first", descending: "fewest first" },
  {
    key: "classified",
    label: "Attributed",
    ascending: "largest share first",
    descending: "smallest share first",
  },
];

/** Which column each sortable heading orders by. The other four hold counts the
 *  page does not offer an order for; a heading that announced itself sortable
 *  with no control behind it would be worse than a plain one. */
const SORTABLE: Record<string, SortKey> = {
  Title: "title",
  "Change rows": "rows",
  Text: "text",
  Attributed: "classified",
};

const COLUMNS = [
  "Title",
  "Change rows",
  "Initial",
  "Text",
  "Notes",
  "Structure",
  "Text classified",
  "Attributed",
];

function ariaSort(key: SortKey | undefined): "ascending" | "descending" | "none" | undefined {
  if (key === undefined) return undefined;
  if (key !== activeKey) return "none";
  return descending ? "descending" : "ascending";
}

/** The heading's own link reverses the order when its column is the one in
 *  force, and otherwise takes the table to that column's first direction. */
function headingHref(key: SortKey): string {
  if (key !== activeKey) return versionDataHref(key);
  return versionDataHref(descending ? key : `${key}-desc`);
}

const KIND_MEANING: Record<string, string> = {
  initial: "The oldest stored version of a section, with nothing before it",
  text: "The statutory text differs",
  notes: "The notes or the source credit differ, and the statutory text does not",
  structure: "Only the XML differs: neither the statutory text nor the notes changed",
};

const ATTRIBUTION_MEANING: Record<string, string> = {
  classified: "A classification-table row of the change's own kind names a law that arrived with it",
  editorial: "Only the Editorial Classification Change Table names one: OLRC moved a provision",
  none: "Nothing in either table names a law that arrived with it",
};

const generated = new Date(report.generated_at);
const generatedLabel = generated.toISOString().slice(0, 10);
const concurrentShare = shareOf(report.concurrent, report.transitions);
const coverage = report.coverage ?? null;
const attribution = attributionRows(report);
const TOP = 10;
const topStructure = topReleases(report, "structure", TOP);
const topText = topReleases(report, "text", TOP);
const structureConcentration = concentration(report, "structure", TOP);
const textConcentration = concentration(report, "text", TOP);

const CORPUS_FIGURES: { label: string; count: number; share: number | null }[] = [
  { label: "Sections covered", count: report.sections_covered, share: null },
  { label: "Version groups", count: report.version_groups_total, share: null },
  { label: "Transitions between version groups", count: report.transitions, share: null },
  { label: "Change rows", count: report.change_rows, share: null },
  {
    label: `Text changes attributed to a Public Law, of ${formatCount(report.by_kind.text.count)}`,
    count: report.text_classified,
    share: report.text_classified_share,
  },
];
if (report.notes_classified !== undefined) {
  CORPUS_FIGURES.push({
    label: `Notes changes attributed to a Public Law, of ${formatCount(report.by_kind.notes.count)}`,
    count: report.notes_classified,
    share: report.notes_classified_share ?? null,
  });
}
if (report.editorial !== undefined) {
  CORPUS_FIGURES.push({
    label: "Changes attributed to an editorial reclassification",
    count: report.editorial,
    share: null,
  });
}
CORPUS_FIGURES.push({
  label: "Public Law attributions recorded",
  count: report.law_rows,
  share: null,
});
if (report.ecct_law_rows !== undefined) {
  CORPUS_FIGURES.push({
    label: "of which recorded from the Editorial Classification Change Table",
    count: report.ecct_law_rows,
    share: null,
  });
}
CORPUS_FIGURES.push({
  label: `Transitions marked concurrent, of ${formatCount(report.transitions)}`,
  count: report.concurrent,
  share: concurrentShare,
});
---

<Base title="Version changes in this corpus · U.S. Code">
  <h1 class="doc-title">Version changes in this corpus</h1>

  <p class="lede">
    How this site decides what changed between two versions of a section, which Public Law it
    attributes the change to, and what the whole corpus contains once every change has been
    classified.
  </p>

  <h2 class="toc-group">What a version is</h2>

  <p>
    The Code republishes every title at every release point whether or not anything in it changed.
    This site keeps one copy of each distinct XML a section has had and records which release points
    published it. Each copy is a <strong>version</strong>; the move from one version to the next is a
    <strong>transition</strong>. A section's oldest version has no transition and is recorded as
    <code>initial</code>.
  </p>

  <p>
    Versions are ordered by the earliest release point that published each one. A transition
    <strong>departs</strong> from the last release point that published the older version and
    <strong>arrives</strong> at the first release point that published the newer one; the release
    points in between are its <strong>window</strong>.
  </p>

  <h2 class="toc-group">The three questions asked of a transition</h2>

  <p>
    Two digests are stored for every version, both taken with all whitespace removed: one of the
    statutory text, one of the notes and the source credit. A transition is classified by asking
    three questions in order and stopping at the first yes:
  </p>

  <ol>
    <li>
      Did the statutory text change? Then it is <code>text</code>. The section's heading is part of
      the statutory text.
    </li>
    <li>Did the notes or the source credit change? Then it is <code>notes</code>.</li>
    <li>
      Otherwise it is <code>structure</code>: the stored XML differs and nothing a reader sees does.
      The differences are attribute values, element-boundary whitespace and the like, most of them
      from a change in the converter that produced the file.
    </li>
  </ol>

  <p>
    A change to whitespace alone inside statutory text answers no to the first question and is
    recorded as <code>structure</code>. The reading redline cannot show such a change either.
  </p>

  <h2 class="toc-group">Which laws could have caused it</h2>

  <p>
    A release point incorporates every Public Law up to and including the one it is named for,
    except the laws its name excludes: <code>119-102not101</code> holds Pub. L. 119–102 and not Pub.
    L. 119–101. The laws that <strong>arrived with a transition</strong> are the ones incorporated at
    the arriving release point and not at the departing one. This is a set difference rather than a
    reading of the labels: between <code>116-344not283u1</code> and <code>116-344</code> the law that
    arrived is Pub. L. 116–283, which is below both labels.
  </p>

  <p>
    A section that first appears part-way through the corpus is treated as arriving from the release
    point before it in its title's load history, so the law that created it can be found. A section
    present at the earliest loaded release point of its title has no window and is attributed to
    nothing.
  </p>

  <h2 class="toc-group">What the tables say about those laws</h2>

  <p>
    The laws that arrived are looked up in two tables OLRC publishes. The
    <a href={`${APP}/classification`}>classification tables</a> record which provision of which
    Public Law was classified to which Code section, and whether as statutory text or as a note.
    The <a href={`${APP}/classification/ecct`}>Editorial Classification Change Table</a> records
    provisions OLRC moved between sections, or between a note and a section, in the course of
    classifying a new law, with the law that prompted the move. Each transition is recorded as one
    of three things:
  </p>

  <ul>
    <li>
      <code>classified</code> — a row of the transition's own kind names a law that arrived with it:
      a text row for a <code>text</code> change, a note row for a <code>notes</code> change, a
      text row for an <code>initial</code> arrival.
    </li>
    <li>
      <code>editorial</code> — no such row, but the Editorial Classification Change Table records a
      law that arrived with it as prompting a move into or out of the section. The change is
      OLRC's, not an amendment to the section.
    </li>
    <li>
      <code>none</code> — neither table names a law that arrived with it. No law is inferred.
    </li>
  </ul>

  <p>
    Every matched law is listed against the transition on the section's version history, saying
    which table named it and, for a move, what moved from where to where.
  </p>

  <h2 class="toc-group">When the release points do not line up</h2>

  <p>
    A transition is marked <strong>concurrent</strong> when the versions on either side of it were
    both published at one release point, or when a third version was published inside its window.
    Both happen when a section's XML returns to an earlier form — a converter alternating between
    two serialisations, or a genuine revert — because this site keeps one version per distinct
    XML rather than one per stretch of time. On such a transition the window cannot be trusted, and
    the version history says so beside the entry.
  </p>

  <h2 class="toc-group">Limitations</h2>

  <ul>
    <li>
      <strong>Attribution reaches {formatShare(report.text_classified_share)} of text changes.</strong
      > The classification tables begin at the 104th Congress; a provision last amended before then
      has no row to match. The Editorial Classification Change Table covers the 119th Congress only
      and records the moves made while classifying new laws; moves made while preparing a main
      edition or supplement are not in it.
    </li>
    <li>
      <strong
        >{formatCount(report.concurrent)} transitions ({formatShare(concurrentShare)}) are marked
        concurrent.</strong
      > Most are XML that recurs rather than the sections the source publishes twice under one
      identifier.
    </li>
    <li>
      <strong>The digests carry no version of their own.</strong> A change to how the statutory text
      is extracted would redefine what every stored digest means. Rebuilding them is a full
      recompute.
    </li>
  </ul>

  <h2 class="toc-group">The corpus</h2>

  {
    coverage ? (
      <p>
        These figures describe the corpus as it stood on <strong>{generatedLabel}</strong>:
        {formatCount(report.sections_covered)} sections across {formatCount(coverage.titles)} titles,
        loaded from the OLRC downloads at {formatCount(coverage.release_points_loaded)} of the
        {formatCount(coverage.release_points)} release points OLRC has published
        {coverage.newest_loaded && (
          <>
            , the newest of them <code>{coverage.newest_loaded.label}</code>, current through{" "}
            {coverage.newest_loaded.currency_date}
          </>
        )}
        .
      </p>
    ) : (
      <p>
        These figures describe the corpus as it stood on <strong>{generatedLabel}</strong>:
        {formatCount(report.sections_covered)} sections across 58 titles, loaded from the OLRC
        downloads at 381 release points, the newest of them <code>119-102not101</code>, published
        12 July 2026.
      </p>
    )
  }

  <div class="uslm-tablewrap" role="region" tabindex="0" aria-label="Corpus-wide totals">
    <table class="usa-table usa-table--striped vdata">
      <caption>Corpus-wide totals</caption>
      <thead>
        <tr>
          <th scope="col">Figure</th>
          <th scope="col" class="vdata__num">Count</th>
          <th scope="col" class="vdata__num">Share</th>
        </tr>
      </thead>
      <tbody>
        {
          CORPUS_FIGURES.map((figure) => (
            <tr>
              <th scope="row">{figure.label}</th>
              <td class="vdata__num">{formatCount(figure.count)}</td>
              <td class="vdata__num">{formatShare(figure.share)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="uslm-tablewrap" role="region" tabindex="0" aria-label="Change rows by kind">
    <table class="usa-table usa-table--striped vdata">
      <caption>Change rows by kind</caption>
      <thead>
        <tr>
          <th scope="col">Kind</th>
          <th scope="col">Meaning</th>
          <th scope="col" class="vdata__num">Rows</th>
          <th scope="col" class="vdata__num">Share</th>
        </tr>
      </thead>
      <tbody>
        {
          (["initial", "text", "notes", "structure"] as const).map((kind) => (
            <tr>
              <th scope="row"><code>{kind}</code></th>
              <td>{KIND_MEANING[kind]}</td>
              <td class="vdata__num">{formatCount(report.by_kind[kind].count)}</td>
              <td class="vdata__num">{formatShare(report.by_kind[kind].share)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="doc-meta">
    The share is of the {formatCount(report.transitions)} transitions. An <code>initial</code> row
    has no share: it is an arrival with no departure, one per section covered.
  </p>

  {
    attribution && (
      <>
        <h2 class="toc-group">Attribution by kind</h2>

        <p>
          What the two tables said about each kind of change. A <code>structure</code> change is
          expected to match nothing: no law arrives with a change nobody can read.
        </p>

        <div class="uslm-tablewrap" role="region" tabindex="0" aria-label="Attribution by kind">
          <table class="usa-table usa-table--striped vdata">
            <caption>Attribution by kind</caption>
            <thead>
              <tr>
                <th scope="col">Kind</th>
                <th scope="col" class="vdata__num">Rows</th>
                {ATTRIBUTIONS.map((value) => (
                  <th scope="col" class="vdata__num">
                    <code>{value}</code>
                  </th>
                ))}
                <th scope="col" class="vdata__num">Classified</th>
              </tr>
            </thead>
            <tbody>
              {attribution.map((row) => (
                <tr>
                  <th scope="row">
                    <code>{row.kind}</code>
                  </th>
                  <td class="vdata__num">{formatCount(row.total)}</td>
                  <td class="vdata__num">{formatCount(row.classified)}</td>
                  <td class="vdata__num">{formatCount(row.editorial)}</td>
                  <td class="vdata__num">{formatCount(row.none)}</td>
                  <td class="vdata__num">{formatShare(row.classifiedShare)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <dl class="vdata__glossary">
          {ATTRIBUTIONS.map((value) => (
            <>
              <dt>
                <code>{value}</code>
              </dt>
              <dd>{ATTRIBUTION_MEANING[value]}</dd>
            </>
          ))}
        </dl>
      </>
    )
  }

  {
    topStructure && topText && (
      <>
        <h2 class="toc-group">Where the changes arrive</h2>

        <p>
          Every transition arrives at one release point. The two tables below name the {TOP} release
          points that received the most <code>structure</code> arrivals and the most
          <code>text</code> arrivals, with each one's share of all arrivals of that kind. Those {TOP}
          hold {formatShare(structureConcentration)} of the <code>structure</code> arrivals and{" "}
          {formatShare(textConcentration)} of the <code>text</code> arrivals: a converter change
          gives one release point a <code>structure</code> arrival for nearly every section of every
          title it republished, while amendments spread across the release points that incorporated
          them.
        </p>

        <div class="vdata__pair">
          <div
            class="uslm-tablewrap"
            role="region"
            tabindex="0"
            aria-label="Release points receiving the most structure arrivals"
          >
            <table class="usa-table usa-table--striped vdata">
              <caption>Most <code>structure</code> arrivals</caption>
              <thead>
                <tr>
                  <th scope="col">Release point</th>
                  <th scope="col" class="vdata__num">Arrivals</th>
                  <th scope="col" class="vdata__num">Share</th>
                </tr>
              </thead>
              <tbody>
                {topStructure.map((entry) => (
                  <tr>
                    <th scope="row">
                      <code>{entry.label}</code>
                    </th>
                    <td class="vdata__num">{formatCount(entry.count)}</td>
                    <td class="vdata__num">{formatShare(entry.share)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div
            class="uslm-tablewrap"
            role="region"
            tabindex="0"
            aria-label="Release points receiving the most text arrivals"
          >
            <table class="usa-table usa-table--striped vdata">
              <caption>Most <code>text</code> arrivals</caption>
              <thead>
                <tr>
                  <th scope="col">Release point</th>
                  <th scope="col" class="vdata__num">Arrivals</th>
                  <th scope="col" class="vdata__num">Share</th>
                </tr>
              </thead>
              <tbody>
                {topText.map((entry) => (
                  <tr>
                    <th scope="row">
                      <code>{entry.label}</code>
                    </th>
                    <td class="vdata__num">{formatCount(entry.count)}</td>
                    <td class="vdata__num">{formatShare(entry.share)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </>
    )
  }

  <h2 class="toc-group">By title</h2>

  <p>
    {formatCount(rows.length)} titles have change rows. The corpus holds 58; titles 11a and 28a
    carry no sections at any release point, so they have no versions to report. The rows below sum
    to the corpus totals above.
  </p>

  <SortBar
    options={SORT_OPTIONS}
    sort={sort}
    href={(option: string) => versionDataHref(option)}
    label="Order the titles"
    idPrefix="vdata-sort"
  />

  <div
    class="uslm-tablewrap vdata__wrap"
    role="region"
    tabindex="0"
    aria-label="Change rows by title"
  >
    <table class="usa-table usa-table--striped vdata vdata--titles">
      <caption>Change rows by title</caption>
      <thead>
        <tr>
          {
            COLUMNS.map((column) => {
              const key = SORTABLE[column];
              const on = key !== undefined && key === activeKey;
              const numeric = column !== "Title";
              return (
                <th
                  scope="col"
                  aria-sort={ariaSort(key)}
                  class={numeric ? "vdata__num" : undefined}
                >
                  {key === undefined ? (
                    column
                  ) : (
                    <a
                      class={`classtable__sortlink${on ? " classtable__sortlink--on" : ""}`}
                      href={headingHref(key)}
                      data-sort-column={key}
                    >
                      {column}
                      <span class="classtable__arrow" aria-hidden="true">
                        {on ? (descending ? "▼" : "▲") : "↕"}
                      </span>
                      <span class="usa-sr-only">
                        {on
                          ? descending
                            ? ", sorted descending. Sort ascending"
                            : ", sorted ascending. Sort descending"
                          : ", sort by this column"}
                      </span>
                    </a>
                  )}
                </th>
              );
            })
          }
        </tr>
      </thead>
      <tbody>
        {
          sorted.map((row) => (
            <tr>
              <th scope="row">{row.num}</th>
              <td class="vdata__num">{formatCount(row.changeRows)}</td>
              <td class="vdata__num">{formatCount(row.initial)}</td>
              <td class="vdata__num">{formatCount(row.text)}</td>
              <td class="vdata__num">{formatCount(row.notes)}</td>
              <td class="vdata__num">{formatCount(row.structure)}</td>
              <td class="vdata__num">{formatCount(row.textClassified)}</td>
              <td class="vdata__num">{formatShare(row.textClassifiedShare)}</td>
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">All {formatCount(rows.length)}</th>
          <td class="vdata__num">{formatCount(report.change_rows)}</td>
          <td class="vdata__num">{formatCount(report.by_kind.initial.count)}</td>
          <td class="vdata__num">{formatCount(report.by_kind.text.count)}</td>
          <td class="vdata__num">{formatCount(report.by_kind.notes.count)}</td>
          <td class="vdata__num">{formatCount(report.by_kind.structure.count)}</td>
          <td class="vdata__num">{formatCount(report.text_classified)}</td>
          <td class="vdata__num">{formatShare(report.text_classified_share)}</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <h2 class="toc-group">Where these numbers come from</h2>

  <p>
    Nothing on this page queries the database. The figures are read from a file committed to the
    repository, so the page renders the same on an empty machine as on the deployed one.
  </p>

  <ul>
    <li>
      Written on <strong>{generatedLabel}</strong> by
      <code>python -m ingest version-changes --report</code>, which recomputes every figure above
      from the stored rows.
    </li>
    <li>
      Committed as <code>docs/verification/version-changes.json</code> and copied to
      <code>frontend/src/data/version-changes.json</code>, which this page reads. A test in the
      browser suite fails the build when the two differ.
    </li>
    <li>
      The corpus described is the one loaded on the machine this site is built from. The deployed
      site's corpus was loaded and back-filled separately, on 2026-09-01, and its own report matched
      this one on every figure above.
    </li>
  </ul>

  <p>
    Loading a further release point moves these figures. Nothing on this page recomputes them: they
    are replaced when the report is run again, and they are correct as of {generatedLabel}.
  </p>

  <p class="doc-meta">
    The method is written up as ADR-0074 and ADR-0077 and in
    <code>docs/version-semantics-spec.md</code> in the{" "}
    <a class="usa-link usa-link--external" rel="noopener" href="https://github.com/aih/uscode-redesign"
      >repository</a
    >. The annotations are shown per section on each{" "}
    <a href={`${APP}/versions/us/usc/t16/s45f`}>version history</a> page.
  </p>
</Base>
