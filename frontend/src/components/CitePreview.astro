---
/**
 * Hover a citation, read what it says, without losing your place. Island #4.
 *
 * A section of the Code can carry forty cross references, and following one to
 * find out whether it matters costs a page load and your scroll position. The
 * `title=""` attribute already on every reference gives the heading; this gives
 * the text.
 *
 * ## Why it is built out of the platform
 *
 * `popover` supplies the top layer, `Escape`, and light dismiss for free.
 * CSS anchor positioning supplies placement — Baseline 2026, ~91% of traffic —
 * with a `getBoundingClientRect` path for the rest. Total cost is a couple of
 * kilobytes against the ~120 KB a React hover-card library would have added to
 * a site that ships no framework at all (ADR-0022).
 *
 * ## WCAG 2.1 SC 1.4.13, clause by clause
 *
 * This is the criterion that governs anything appearing on hover, and each of
 * its three requirements is a specific mechanism here, each with a test in
 * `frontend/tests/e2e/preview.spec.ts`:
 *
 *   * **Dismissible** — `Escape` closes the card without moving the pointer.
 *   * **Hoverable** — the close is delayed and cancelled when the pointer
 *     enters the card, so you can move onto it and scroll. This is the clause
 *     most hover previews fail.
 *   * **Persistent** — it stays until dismissed, until the pointer leaves both
 *     the link and the card, or until focus moves.
 *
 * ## Two decisions worth arguing with
 *
 * **The card is a non-modal dialog, reachable from the trigger.** It used to
 * carry `aria-hidden="true"` *and* `tabindex="0"` — focusable and hidden from
 * assistive technology at the same time, which is the one combination that is
 * unambiguously wrong (axe `aria-hidden-focus`, found by the open-state scan in
 * ADR-0039). `aria-hidden` is gone. Nothing announces on open, because nothing
 * moves focus on open and there is no live region — so ADR-0024's worry, that a
 * forty-reference section would read forty paragraphs of statutory text at
 * somebody, does not happen. What changed is that a reader who *wants* the card
 * can now reach it: Tab from the trigger moves in, Escape moves back out.
 * Amended in ADR-0041.
 *
 * **Touch navigates.** The whole feature is behind
 * `(hover: hover) and (pointer: fine)`. Hover does not exist on a phone, and
 * every workaround (first-tap-opens, long-press) fights either the OS or the
 * reader's expectation that a link is a link. A tap opens the citation.
 */
---

{/* One card, reused for every reference on the page. `manual` rather than
    `auto` because `auto` light-dismisses on any outside pointerdown, which
    includes the scrollbar of the card's own scroll area.

    `tabindex="0"` stays: the body scrolls, and a scrollable region with no
    focusable children is unreachable by keyboard without it (axe
    `scrollable-region-focusable`). `aria-label` is set per reference when the
    card opens, so focus arriving here announces what is being previewed
    rather than "dialog". */}
<div
  id="cite-preview"
  class="cite-preview"
  popover="manual"
  role="dialog"
  tabindex="0"
></div>

<script is:inline>
  {
    // Hover is a pointer capability, not a screen size. A phone in landscape is
    // still a phone; a touchscreen laptop with a mouse still hovers.
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      const card = document.getElementById("cite-preview");

      // Long enough that dragging the pointer across a paragraph of citations
      // does not fire four requests; short enough to feel like a hover.
      const OPEN_DELAY = 300;
      // The "hoverable" clause of SC 1.4.13 lives in this number: the gap the
      // pointer has to cross from link to card without the card vanishing.
      const CLOSE_DELAY = 250;

      const cache = new Map();
      let openTimer = null;
      let closeTimer = null;
      let inFlight = null;
      let anchor = null;
      /** The reference whose card the reader explicitly dismissed.
       *
       * Without this, Escape is useless from the keyboard: `hide()` returns
       * focus to the trigger, `focusin` fires on the trigger, and the card the
       * reader just dismissed reopens 300ms later. Cleared as soon as attention
       * moves to a different reference. */
      let dismissed = null;

      const cancelTimers = () => {
        clearTimeout(openTimer);
        clearTimeout(closeTimer);
      };

      const isOpen = () => card.matches(":popover-open");

      function hide() {
        cancelTimers();
        if (anchor) anchor.style.removeProperty("anchor-name");
        anchor = null;
        try {
          card.hidePopover();
        } catch {
          /* already closed */
        }
      }

      /**
       * Close, and put focus back where the reader left it.
       *
       * Separate from `hide()` on purpose: `hide()` also runs on mouseout and on
       * scroll, and moving focus in either case would yank a keyboard reader
       * somewhere they never asked to be. Only a deliberate dismissal restores.
       */
      function dismiss() {
        const trigger = anchor;
        const hadFocus = card.contains(document.activeElement) || document.activeElement === card;
        if (trigger) dismissed = trigger;
        hide();
        // Only if focus was inside the card. Escape pressed with focus still on
        // the link should close the card and leave the reading position exactly
        // where it is, which it already is.
        if (hadFocus && trigger) trigger.focus({ preventScroll: true });
      }

      /** Everything inside the card a Tab could land on. */
      const focusables = () =>
        [...card.querySelectorAll('a[href], button, [tabindex]:not([tabindex="-1"])')].filter(
          (el) => el.offsetParent !== null || el === document.activeElement,
        );

      function scheduleHide() {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(hide, CLOSE_DELAY);
      }

      function place(link) {
        const supportsAnchor = CSS.supports("anchor-name: --x");
        if (supportsAnchor) {
          link.style.setProperty("anchor-name", "--cite-anchor");
          card.style.removeProperty("top");
          card.style.removeProperty("left");
          return;
        }
        // Safari 18.2–18.3 has `anchor()` but not `@position-try`, and older
        // browsers have neither. Placement is the one thing that cannot degrade
        // to nothing, so it is measured by hand.
        const box = link.getBoundingClientRect();
        const width = Math.min(28 * 16, window.innerWidth - 24);
        const left = Math.max(12, Math.min(box.left, window.innerWidth - width - 12));
        const below = window.innerHeight - box.bottom;
        card.style.left = `${left}px`;
        if (below < 260 && box.top > below) {
          card.style.top = `${Math.max(12, box.top - Math.min(352, box.top - 12))}px`;
        } else {
          card.style.top = `${box.bottom + 6}px`;
        }
      }

      async function load(identifier, release) {
        const key = `${identifier}|${release ?? ""}`;
        if (cache.has(key)) return cache.get(key);

        // Cancel whatever the last hover started: the pointer has moved on and
        // that answer is no longer wanted.
        inFlight?.abort();
        const controller = new AbortController();
        inFlight = controller;

        const url =
          `/app/preview${identifier}` + (release ? `?release=${encodeURIComponent(release)}` : "");
        const response = await fetch(url, { signal: controller.signal });
        if (!response.ok) {
          // 429 in particular: the preview endpoint is rate-limited per caller
          // (ADR-0029), and a reader moving down a dense section will meet it.
          const failure = new Error(String(response.status));
          failure.status = response.status;
          throw failure;
        }
        const html = await response.text();
        cache.set(key, html);
        return html;
      }

      /**
       * What the card says when the fragment could not be fetched.
       *
       * Never nothing. A card that silently declines to open is
       * indistinguishable from a feature that is broken, or from a citation
       * with no text behind it — and the reader is left with no next step. This
       * one names the failure and offers the link, which is the fallback that
       * was always there and was never said out loud.
       */
      function failureHtml(link, status) {
        const href = link.getAttribute("href") ?? "#";
        const reason =
          status === 429
            ? "Preview unavailable — too many previews just now."
            : "Preview unavailable.";
        return (
          `<p class="cite-preview__note">${reason}</p>` +
          `<p class="cite-preview__foot"><a href="${href}">Open the citation →</a></p>`
        );
      }

      async function show(link) {
        const identifier = link.dataset.cite;
        if (!identifier) return;
        const release = link.dataset.citeRelease || null;

        let html;
        try {
          html = await load(identifier, release);
        } catch (error) {
          // An aborted request is this island superseding itself — the pointer
          // moved on and that answer is no longer wanted. Everything else is a
          // failure the reader is entitled to see.
          if (error?.name === "AbortError") return;
          html = failureHtml(link, error?.status);
        }
        // The pointer may have left while that was in flight.
        if (!link.matches(":hover") && document.activeElement !== link) return;

        card.innerHTML = html;
        card.setAttribute(
          "aria-label",
          `Preview: ${link.getAttribute("title") || link.textContent?.trim() || "cited provision"}`,
        );
        anchor = link;
        place(link);
        try {
          card.showPopover();
        } catch {
          /* already open */
        }
      }

      function scheduleShow(link) {
        // A card the reader dismissed stays dismissed until they look elsewhere.
        if (link === dismissed) return;
        dismissed = null;
        cancelTimers();
        openTimer = setTimeout(() => show(link), OPEN_DELAY);
      }

      /** A reference on the page, or `null`.
       *
       * References *inside* the card are excluded deliberately. The card's body
       * is rendered by the same `uslm.ts` as the page, so it carries
       * `data-cite` links of its own, and the delegated listener below would
       * happily match them — replacing the card's contents while anchored to a
       * link inside itself. One level of preview; the links in it navigate. */
      const referenceFrom = (event) => {
        const link = event.target.closest?.("a[data-cite]");
        return link && !card.contains(link) ? link : null;
      };

      // Delegated, because the statutory text is inserted with `set:html` and
      // may hold hundreds of references — one listener, not one per link.
      document.addEventListener("mouseover", (event) => {
        const link = referenceFrom(event);
        if (link) scheduleShow(link);
      });

      document.addEventListener("mouseout", (event) => {
        const link = referenceFrom(event);
        if (!link) return;
        // Leaving a dismissed reference clears the dismissal: "not now" is
        // about this look at it, not about this citation forever.
        if (link === dismissed) dismissed = null;
        scheduleHide();
      });

      // Keyboard parity: focusing a reference opens the same card. SC 1.4.13
      // covers focus as well as hover, and a keyboard reader has the same
      // question about a cross reference that a mouse reader does.
      document.addEventListener("focusin", (event) => {
        const link = referenceFrom(event);
        if (link) scheduleShow(link);
        else if (!card.contains(event.target)) hide();
      });

      document.addEventListener("focusout", (event) => {
        const link = referenceFrom(event);
        if (!link) return;
        // Focus moving *into* the card is not focus leaving the reference —
        // without this the card schedules its own close as the reader arrives.
        if (card.contains(event.relatedTarget)) return;
        if (link === dismissed && event.relatedTarget !== card) dismissed = null;
        scheduleHide();
      });

      // Hoverable: moving onto the card keeps it open, which is what makes a
      // scrollable preview usable at all.
      card.addEventListener("mouseenter", cancelTimers);
      card.addEventListener("mouseleave", scheduleHide);
      card.addEventListener("focusin", cancelTimers);

      // Dismissible, without moving the pointer.
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          if (isOpen()) dismiss();
          return;
        }
        // Tab from the trigger goes *into* the card rather than past it. The
        // card is a popover in the top layer at the end of the document, so
        // without this its content is not in the reader's tab order in any
        // useful sense — the next Tab would land on the following sentence.
        if (event.key !== "Tab" || event.shiftKey) return;
        if (!isOpen() || event.target !== anchor) return;
        event.preventDefault();
        (focusables()[0] ?? card).focus({ preventScroll: true });
      });

      // And back out again. Leaving the card in either direction closes it and
      // returns the reader to the reference they came from, so the card is
      // never something to escape from by tabbing through statutory text.
      card.addEventListener("keydown", (event) => {
        if (event.key !== "Tab") return;
        const stops = focusables();
        const first = stops[0] ?? card;
        const last = stops[stops.length - 1] ?? card;
        const leavingBackwards = event.shiftKey && (document.activeElement === first || stops.length === 0);
        const leavingForwards = !event.shiftKey && (document.activeElement === last || stops.length === 0);
        if (!leavingBackwards && !leavingForwards) return;
        event.preventDefault();
        dismiss();
      });

      // A card anchored to a link that has scrolled away is worse than no card.
      window.addEventListener("scroll", () => anchor && hide(), { passive: true });
    }
  }
</script>
