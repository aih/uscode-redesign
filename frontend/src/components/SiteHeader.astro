---
/**
 * The site navbar the BUILDLOG 008 review found missing entirely: a brand, and
 * the three places a reader actually needs to reach from anywhere — the titles,
 * the release points, and the API.
 *
 * USWDS's basic header, and no JavaScript. The nav was a plain list that wrapped
 * on a phone, on the reasoning that four links you can already read beat a menu
 * you must tap to see. There are seven items now, and at 375px they wrapped to
 * three 44px bands above the statute; between 40em and 64em they are also
 * sticky, which is 88px of `--sticky-h` spent on the menu before the reader
 * reaches a word of law. Below 64em they collapse into `.navmenu` — a native
 * `<details>`, the same script-free disclosure `ReleasePicker` uses (ADR-0056),
 * whose panel is `position: absolute` so opening it moves nothing. Above 64em
 * the summary is hidden and the list is a row again (ADR-0058).
 */
import AuthNav from "./AuthNav.astro";
import ComingSoon from "./ComingSoon.astro";
import SiteSearch from "./SiteSearch.astro";
import DensityToggle from "./DensityToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import {
  ACCOUNTS_ENABLED,
  ACCOUNTS_NOTICE,
  DOWNLOADS_ENABLED,
  DOWNLOADS_NOTICE,
} from "../lib/features";
import { APP } from "../lib/url";

interface Props {
  /** Prefills the one search box when a page is showing a query's results. */
  searchValue?: string | null;
}

const { searchValue = null } = Astro.props;
---

<header class="usa-header usa-header--basic" role="banner">
  <div class="usa-nav-container">
    <div class="usa-navbar">
      <div class="usa-logo">
        <em class="usa-logo__text">
          <a href={`${APP}/`} title="United States Code">United States Code</a>
        </em>
      </div>
    </div>
    <nav aria-label="Primary" class="usa-nav">
      {/* `<summary>` is exposed as a button carrying its own expanded state, so
          the disclosure needs no `aria-expanded` of its own and no script to
          keep one in sync. The two icons are inline rather than `<img>`: they
          have to take their colour from `--ink` in both themes, and an external
          SVG cannot. */}
      <details class="navmenu">
        <summary class="navmenu__summary">
          <svg
            class="navmenu__icon navmenu__icon--open"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M3 6h18M3 12h18M3 18h18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <svg
            class="navmenu__icon navmenu__icon--close"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M5 5l14 14M19 5L5 19"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <span class="navmenu__label">Menu</span>
        </summary>
        <ul class="usa-nav__primary usa-accordion">
          <li class="usa-nav__primary-item">
            <a class="usa-nav__link" href={`${APP}/`}><span>Titles</span></a>
          </li>
          <li class="usa-nav__primary-item">
            <a class="usa-nav__link" href={`${APP}/releases`}><span>Release points</span></a>
          </li>
          <li class="usa-nav__primary-item">
            <a class="usa-nav__link" href={`${APP}/provisions`}><span>My Provisions</span></a>
          </li>
          {/* The guide (ADR-0038). Ahead of the API reference because it is the
              one thing here written for a reader who does not already know what
              the site does. */}
          <li class="usa-nav__primary-item">
            <a class="usa-nav__link" href={`${APP}/guide`}><span>User guide</span></a>
          </li>
          {/* `/app/docs`, not FastAPI's `/docs`. The bare Swagger page is a
              different site — no navbar, no footer, no way back — so the reader
              who clicks "API docs" from here has left. The reader page wraps the
              same OpenAPI schema in this chrome. */}
          <li class="usa-nav__primary-item">
            <a class="usa-nav__link" href={`${APP}/docs`}><span>API docs</span></a>
          </li>
          {/* The disclaimer this site has always carried in the footer — "a
              conceptual redesign … not an official publication" — is the single
              most important sentence on the page for anyone who lands on a
              provision from a search engine, and it was in eight-point grey type
              below the fold. It has a page now, and this is the way in. */}
          <li class="usa-nav__primary-item">
            <a class="usa-nav__link" href={`${APP}/about`}><span>About</span></a>
          </li>
          {/* Not a link, because there is nothing to link to yet — it explains
              itself instead of 404ing. See `ComingSoon` for why it is not
              `<button disabled>`. */}
          {!DOWNLOADS_ENABLED && (
            <li class="usa-nav__primary-item">
              <ComingSoon
                id="downloads"
                label="Downloads"
                heading={DOWNLOADS_NOTICE.heading}
                lead={DOWNLOADS_NOTICE.lead}
                detail={DOWNLOADS_NOTICE.detail}
              >
                <p class="soon__detail">
                  <a
                    class="usa-link usa-link--external"
                    rel="noopener"
                    href="https://uscode.house.gov/download/download.shtml">
                    Release-point downloads at the OLRC
                  </a>
                </p>
              </ComingSoon>
            </li>
          )}
        </ul>
      </details>
      {/* The chrome's controls share one row at every width — which is also
          what keeps them out of `--sticky-h`: a second block in the nav would
          add a whole 44px band to the sticky stack between 40em and 64em, and
          that token is what `scroll-margin-top` spends.

          There used to be two boxes here, a keyword search and a citation jump,
          on the reasoning that they answer different questions: one goes to a
          provision you can already name, the other is for when you cannot. True,
          and still not worth two controls — the reader knows what they typed,
          the server can tell which it is, and two boxes sharing this row meant
          both were slivers below ~50em. `SiteSearch` is the merged one; the
          two toggles at the end are the reading-comfort controls rather than
          navigation — the theme (ADR-0027) and the reading density
          (ADR-0054), which is why they sit together. */}
      <div class="navtools">
        <SiteSearch value={searchValue} />
        {/* `AuthNav` is the island that asks `/api/v1/auth/me` who the reader
            is. With accounts switched off there is nobody to be, so it is not
            rendered at all rather than rendered and hidden — a hidden island
            still ships its script and still makes the request, on every page,
            to be told 401. The control that takes its place explains what an
            account will be for, and is plain server-rendered markup.
            `AuthNav` itself is untouched: `ACCOUNTS_ENABLED = true` puts it
            back. */}
        {ACCOUNTS_ENABLED ? (
          <AuthNav />
        ) : (
          <span class="authnav authnav--off">
            <ComingSoon
              id="accounts"
              label="Accounts"
              heading={ACCOUNTS_NOTICE.heading}
              lead={ACCOUNTS_NOTICE.lead}
              detail={ACCOUNTS_NOTICE.detail}
            />
          </span>
        )}
        <DensityToggle />
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
