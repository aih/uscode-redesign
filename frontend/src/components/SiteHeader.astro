---
/**
 * The site navbar the BUILDLOG 008 review found missing entirely: a brand, and
 * the three places a reader actually needs to reach from anywhere — the titles,
 * the release points, and the API.
 *
 * USWDS's basic header, and no JavaScript: the nav is a plain list that wraps on
 * a phone rather than a menu that has to be opened. A menu you must tap to see is
 * worse than four links you can already read.
 */
import CitationJump from "./CitationJump.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { APP } from "../lib/url";
---

<header class="usa-header usa-header--basic" role="banner">
  <div class="usa-nav-container">
    <div class="usa-navbar">
      <div class="usa-logo">
        <em class="usa-logo__text">
          <a href={`${APP}/`} title="United States Code">United States Code</a>
        </em>
      </div>
    </div>
    <nav aria-label="Primary" class="usa-nav">
      <ul class="usa-nav__primary usa-accordion">
        <li class="usa-nav__primary-item">
          <a class="usa-nav__link" href={`${APP}/`}><span>Titles</span></a>
        </li>
        <li class="usa-nav__primary-item">
          <a class="usa-nav__link" href={`${APP}/releases`}><span>Release points</span></a>
        </li>
        <li class="usa-nav__primary-item">
          <a class="usa-nav__link" href={`${APP}/provisions`}><span>My Provisions</span></a>
        </li>
        <li class="usa-nav__primary-item">
          <a class="usa-nav__link" href="/docs"><span>API docs</span></a>
        </li>
      </ul>
      {/* The chrome's controls share one row at every width — which is also
          what keeps them out of `--sticky-h`: a second block in the nav would
          add a whole 44px band to the sticky stack between 40em and 64em, and
          that token is what `scroll-margin-top` spends. The search box joins
          this row for the same reason rather than sitting under the nav.

          Search and the citation box are both navigation, and they are not the
          same one: the citation box goes straight to a provision you can
          already name, search is for when you cannot. The theme toggle is the
          only thing here that is purely about reading comfort. */}
      <div class="navtools">
        <form
          class="usa-search usa-search--small"
          role="search"
          action={`${APP}/search`}
          method="get"
          style="flex: 1 1 12rem; min-width: 0; margin: 0;"
        >
          <label class="usa-sr-only" for="search-field">Search</label>
          <input class="usa-input" id="search-field" type="search" name="q" placeholder="Search the Code..." />
          <button class="usa-button" type="submit">
            <span class="usa-sr-only">Search</span>
          </button>
        </form>
        <CitationJump />
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
