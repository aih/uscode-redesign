---
/**
 * The site navbar the BUILDLOG 008 review found missing entirely: a brand, and
 * the three places a reader actually needs to reach from anywhere — the titles,
 * the release points, and the API.
 *
 * USWDS's basic header, and no JavaScript: the nav is a plain list that wraps on
 * a phone rather than a menu that has to be opened. A menu you must tap to see is
 * worse than four links you can already read.
 */
import AuthNav from "./AuthNav.astro";
import SiteSearch from "./SiteSearch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { APP } from "../lib/url";

interface Props {
  /** Prefills the one search box when a page is showing a query's results. */
  searchValue?: string | null;
}

const { searchValue = null } = Astro.props;
---

<header class="usa-header usa-header--basic" role="banner">
  <div class="usa-nav-container">
    <div class="usa-navbar">
      <div class="usa-logo">
        <em class="usa-logo__text">
          <a href={`${APP}/`} title="United States Code">United States Code</a>
        </em>
      </div>
    </div>
    <nav aria-label="Primary" class="usa-nav">
      <ul class="usa-nav__primary usa-accordion">
        <li class="usa-nav__primary-item">
          <a class="usa-nav__link" href={`${APP}/`}><span>Titles</span></a>
        </li>
        <li class="usa-nav__primary-item">
          <a class="usa-nav__link" href={`${APP}/releases`}><span>Release points</span></a>
        </li>
        <li class="usa-nav__primary-item">
          <a class="usa-nav__link" href={`${APP}/provisions`}><span>My Provisions</span></a>
        </li>
        {/* `/app/docs`, not FastAPI's `/docs`. The bare Swagger page is a
            different site — no navbar, no footer, no way back — so the reader
            who clicks "API docs" from here has left. The reader page wraps the
            same OpenAPI schema in this chrome. */}
        <li class="usa-nav__primary-item">
          <a class="usa-nav__link" href={`${APP}/docs`}><span>API docs</span></a>
        </li>
      </ul>
      {/* The chrome's controls share one row at every width — which is also
          what keeps them out of `--sticky-h`: a second block in the nav would
          add a whole 44px band to the sticky stack between 40em and 64em, and
          that token is what `scroll-margin-top` spends.

          There used to be two boxes here, a keyword search and a citation jump,
          on the reasoning that they answer different questions: one goes to a
          provision you can already name, the other is for when you cannot. True,
          and still not worth two controls — the reader knows what they typed,
          the server can tell which it is, and two boxes sharing this row meant
          both were slivers below ~50em. `SiteSearch` is the merged one; the
          theme toggle is the only thing left here that is about reading comfort
          rather than navigation. */}
      <div class="navtools">
        <SiteSearch value={searchValue} />
        <AuthNav />
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>
