---
/**
 * The site navbar: a brand, two destinations, the one search box, and a menu
 * holding everything else (ADR-0061).
 *
 * It had eleven interactive items on one row — seven links, an account control,
 * two display toggles and the search box with its button — which is a menu that
 * has to be read rather than scanned. It has four: **Titles**, **My
 * Provisions**, the search box (ADR-0023) and **More**. The contextbar's
 * release switcher (ADR-0056) is a different control on a different bar and is
 * untouched; the "Release points" link this header used to carry was only the
 * archive page, and it is in More.
 *
 * ## Three disclosures, and what closes them
 *
 * `Titles` and `More` are `<details>`, the script-free disclosure `ReleasePicker`
 * chose (ADR-0056) and the menus took (ADR-0058): a `<summary>` is exposed as a
 * button carrying its own expanded state, so neither needs an `aria-expanded`
 * kept in sync by hand. `.navmenu` is still the hamburger below 64em.
 *
 * What `<details>` does not do is close. Two open menus overlapping each other
 * is a real state of this markup, and so is a menu left open behind the reader
 * halfway down a section. So this component ships the first script the site
 * chrome has ever had — Escape, outside pointer, and one open at a time. It is
 * deliberately not `<details name>`, the platform's exclusive-accordion
 * grouping: that closes *any* same-named sibling, including an ancestor, and
 * `Titles` sits inside `.navmenu` below 64em. The script closes what does not
 * contain what is being opened, which is the same rule with the nesting case
 * right.
 *
 * A popover open inside a menu owns Escape first, which is why the key handler
 * steps aside for one: Escape over the Downloads explanation should shut the
 * explanation, not the menu it was opened from.
 *
 * ## Why More is in the list rather than at the far right
 *
 * The proposal put a spacer between the search box and More. That needs either
 * `order` on a flex item or the search box in front of the menus in the markup,
 * and both of them make the tab order differ from the reading order at one
 * width or the other. In the list, the reader tabs the header in the order they
 * see it at every width, and below 64em there is one menu rather than a
 * hamburger with a second disclosure loose beside it.
 *
 * ## Where the toggles went
 *
 * The reading density (ADR-0054) and the theme (ADR-0027) are in More under
 * DISPLAY. The theme is *also* on the mobile bar below 64em (ADR-0064), which
 * is the one control this header renders twice: `ThemeToggle`'s script binds
 * every `[data-theme-toggle]` on the page, so the two buttons stay in step, and
 * only the instance that ships that script may be the last one in the document
 * — an inline script cannot bind a button the parser has not reached yet.
 *
 * ## Two rows below 64em, one above (ADR-0064)
 *
 * `.navbar` is the 52px bar — Menu, the wordmark, the theme — and `.navtools`
 * is the search row under it, always on screen. Above 64em `.navbar` is
 * `display: contents`, its wordmark and its theme button are `display: none`,
 * and what is left is the row ADR-0061 built: the list, then the box.
 *
 * The wordmark is written twice because the two bands want it in a different
 * place in the *document*, not only on screen: `.usa-navbar`'s copy is USWDS's
 * and leads the desktop row, and `.navbar__brand`'s sits between the menu and
 * the theme on the bar. Exactly one of them is displayed at any width, so
 * there is one home link in the accessibility tree and one in the tab order.
 * The alternative is `order` on a flex item, which is what ADR-0061 decision 4
 * refused: it would leave the reader tabbing the bar in an order they cannot
 * see.
 *
 * The Accounts row is last, and is the slot `AuthNav` takes when
 * `ACCOUNTS_ENABLED` flips (ADR-0034). With accounts off, the island is not
 * rendered at all rather than rendered and hidden: a hidden island still ships
 * its script and still asks `/api/v1/auth/me` who is reading, on every page, to
 * be told nobody.
 */
import AuthNav from "./AuthNav.astro";
import ComingSoon from "./ComingSoon.astro";
import SiteSearch from "./SiteSearch.astro";
import DensityToggle from "./DensityToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import {
  ACCOUNTS_ENABLED,
  ACCOUNTS_NOTICE,
  DOWNLOADS_ENABLED,
  DOWNLOADS_NOTICE,
} from "../lib/features";
import { APP, appHref } from "../lib/url";
import { NAV_TITLES } from "../data/nav-titles";

interface Props {
  /** Prefills the one search box when a page is showing a query's results. */
  searchValue?: string | null;
}

const { searchValue = null } = Astro.props;

/** One href and one string for both copies of the wordmark. */
const home = `${APP}/`;
const wordmark = "United States Code";
---

<header class="usa-header usa-header--basic" role="banner">
  <div class="usa-nav-container">
    {/* USWDS's own bar, and the desktop row's first item. Hidden below 64em,
        where `.navbar` below is the bar instead. */}
    <div class="usa-navbar">
      <div class="usa-logo">
        <em class="usa-logo__text">
          <a href={home} title={wordmark}>{wordmark}</a>
        </em>
      </div>
    </div>
    <nav aria-label="Primary" class="usa-nav">
      {/* The 52px bar below 64em; `display: contents` above it, where these
          three are items of the nav's own row (ADR-0064). */}
      <div class="navbar">
      {/* The two icons are inline rather than `<img>`: they have to take their
          colour from `--ink` in both themes, and an external SVG cannot. */}
      <details class="navmenu" data-navmenu>
        <summary class="navmenu__summary">
          <svg
            class="navmenu__icon navmenu__icon--open"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M3 6h18M3 12h18M3 18h18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <svg
            class="navmenu__icon navmenu__icon--close"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M5 5l14 14M19 5L5 19"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <span class="navmenu__label">Menu</span>
        </summary>
        <ul class="usa-nav__primary usa-accordion">
          <li class="usa-nav__primary-item">
            {/* Seven titles and a way to all of them. The shortlist is
                editorial and says so where it is written — this header reaches
                no data, so it could not be anything else. */}
            <details class="navdrop navdrop--titles" data-navmenu>
              <summary class="navdrop__summary">
                <span>Titles</span>
                <span class="navdrop__caret" aria-hidden="true">▾</span>
              </summary>
              <div class="navdrop__panel">
                <ul class="navdrop__list">
                  {NAV_TITLES.map((title) => (
                    <li>
                      <a class="navdrop__item" href={appHref(`/us/usc/t${title.num}`)}>
                        <span class="navdrop__num">Title {title.num}</span>
                        <span class="navdrop__name">{title.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="navdrop__item navdrop__item--all" href={`${APP}/`}>
                  All titles <span aria-hidden="true">→</span>
                </a>
              </div>
            </details>
          </li>
          <li class="usa-nav__primary-item">
            <a class="usa-nav__link" href={`${APP}/provisions`}><span>My Provisions</span></a>
          </li>
          <li class="usa-nav__primary-item">
            <details class="navdrop navdrop--more" data-navmenu>
              <summary class="navdrop__summary">
                <span>More</span>
                <span class="navdrop__caret" aria-hidden="true">▾</span>
              </summary>
              <div class="navdrop__panel navdrop__panel--more">
                <p class="navdrop__group" id="navmore-reference">Reference</p>
                <ul class="navdrop__list" aria-labelledby="navmore-reference">
                  <li>
                    <a class="navdrop__item" href={`${APP}/releases`}>Release points</a>
                  </li>
                  {/* Not a link, because there is nothing to link to yet — it
                      explains itself instead of 404ing. See `ComingSoon` for
                      why it is not `<button disabled>`. */}
                  {!DOWNLOADS_ENABLED && (
                    <li>
                      <ComingSoon
                        id="downloads"
                        label="Downloads"
                        heading={DOWNLOADS_NOTICE.heading}
                        lead={DOWNLOADS_NOTICE.lead}
                        detail={DOWNLOADS_NOTICE.detail}
                      >
                        <p class="soon__detail">
                          <a
                            class="usa-link usa-link--external"
                            rel="noopener"
                            href="https://uscode.house.gov/download/download.shtml">
                            Release-point downloads at the OLRC
                          </a>
                        </p>
                      </ComingSoon>
                    </li>
                  )}
                </ul>

                <p class="navdrop__group" id="navmore-help">Help</p>
                <ul class="navdrop__list" aria-labelledby="navmore-help">
                  {/* The guide (ADR-0038), ahead of the API reference because
                      it is the one thing here written for a reader who does not
                      already know what the site does. */}
                  <li><a class="navdrop__item" href={`${APP}/guide`}>User guide</a></li>
                  {/* `/app/docs`, not FastAPI's `/docs`. The bare Swagger page
                      is a different site — no navbar, no footer, no way back. */}
                  <li><a class="navdrop__item" href={`${APP}/docs`}>API docs</a></li>
                  {/* The disclaimer this site carries in the footer — "a
                      conceptual redesign … not an official publication" — is the
                      single most important sentence on the page for anyone who
                      lands on a provision from a search engine. It has a page,
                      and this is the way in. */}
                  <li><a class="navdrop__item" href={`${APP}/about`}>About</a></li>
                </ul>

                <p class="navdrop__group" id="navmore-display">Display</p>
                <ul class="navdrop__list" aria-labelledby="navmore-display">
                  <li><DensityToggle /></li>
                  {/* The theme's second button. The bar's copy carries the
                      island's script, because it is the later of the two in the
                      document and an inline script binds what has already been
                      parsed. */}
                  <li><ThemeToggle script={false} /></li>
                </ul>

                <div class="navdrop__account">
                  {ACCOUNTS_ENABLED ? (
                    <AuthNav />
                  ) : (
                    <span class="authnav authnav--off">
                      <ComingSoon
                        id="accounts"
                        label="Accounts"
                        heading={ACCOUNTS_NOTICE.heading}
                        lead={ACCOUNTS_NOTICE.lead}
                        detail={ACCOUNTS_NOTICE.detail}
                      />
                    </span>
                  )}
                </div>
              </div>
            </details>
          </li>
        </ul>
      </details>

        {/* The bar's wordmark. Displayed below 64em, where `.usa-navbar`'s copy
            is not, so exactly one of the two is ever a link on the page. */}
        <span class="navbar__brand">
          <a href={home} title={wordmark}>{wordmark}</a>
        </span>

        {/* One tap from any page below 64em, which is where ADR-0061 left it
            two. It keeps its icon and drops its word here, the arrangement
            ADR-0059 measured for this band. */}
        <ThemeToggle />
      </div>

      {/* A row of its own below 64em and a share of the nav's row above it. The
          box is on screen at every width without opening anything: it is the
          control the site is built around (ADR-0023). */}
      <div class="navtools">
        <SiteSearch value={searchValue} />
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  {
    // Escape, outside pointer, and one open at a time. Why this is a script at
    // all, and why not `<details name>`, is in this file's frontmatter.
    const menus = [...document.querySelectorAll("[data-navmenu]")];
    const shut = (keep) => {
      for (const menu of menus) {
        if (menu.open && menu !== keep && !menu.contains(keep)) menu.open = false;
      }
    };

    for (const menu of menus) {
      menu.addEventListener("toggle", () => {
        if (menu.open) shut(menu);
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      // A popover opened from inside a menu owns Escape first.
      if (document.querySelector("[popover]:popover-open")) return;
      const open = menus.filter((menu) => menu.open).pop();
      if (!open) return;
      open.open = false;
      open.firstElementChild.focus();
    });

    document.addEventListener("pointerdown", (event) => {
      if (menus.some((menu) => menu.open && menu.contains(event.target))) return;
      shut(null);
    });
  }
</script>
