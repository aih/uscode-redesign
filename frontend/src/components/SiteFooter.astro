---
/**
 * The footer, which the BUILDLOG 008 review also found missing.
 *
 * It says what this site is, because a page of statutory text that does not
 * identify its publisher is a page a researcher cannot cite. The source of the
 * data is named, and linked, on every page.
 *
 * Its links are styled to match the navbar's rather than USWDS's own footer
 * treatment. That was a visible inconsistency — the same four destinations,
 * underlined at the bottom of the page and not at the top — and between the two
 * the navbar is right: a row of navigation is read as a set of choices, and
 * underlining every one of them turns a menu into a paragraph of links. Both
 * now underline on hover and focus, which is where the affordance is actually
 * needed. See `.usa-footer__nav` in `site.scss`.
 *
 * The disclaimer stays where it has always been and is now also a link: it is
 * the most important sentence on the page for anyone who arrived from a search
 * engine, and it had no room here to say anything more.
 *
 * Below 64em the nine links collapse into `.footmenu`, the same `<details>`
 * disclosure the navbar uses (ADR-0058). Nothing here is sticky, so this panel
 * opens in flow rather than over the page. The disclaimer below it is not part
 * of the disclosure: it is the sentence a reader who arrived from a search
 * engine most needs, and it stays on screen.
 *
 * The nine are in four named groups — Browse, Learn, Developers, Site
 * (ADR-0062). Each label is a real `<h2>` naming its own list, so the groups
 * are headings a screen reader can jump between rather than type set to look
 * like headings. The columns are four from 40em, two from 25em and one below
 * that.
 */
import { APP, syntaxHref } from "../lib/url";

declare const __COMMIT_HASH__: string;
const commitHash: string = __COMMIT_HASH__;
const shortHash = commitHash.slice(0, 7);
const repoUrl = "https://github.com/aih/uscode-redesign";
const commitUrl = commitHash !== "unknown" ? `${repoUrl}/commit/${commitHash}` : repoUrl;
---

<footer class="usa-footer usa-footer--slim">
  <div class="usa-footer__primary-section">
    <div class="usa-footer__primary-container grid-row">
      <nav class="usa-footer__nav" aria-label="Footer">
        <details class="footmenu">
          <summary class="footmenu__summary">
            <svg
              class="footmenu__icon footmenu__icon--open"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M3 6h18M3 12h18M3 18h18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
            <svg
              class="footmenu__icon footmenu__icon--close"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M5 5l14 14M19 5L5 19"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"></path>
            </svg>
            <span class="footmenu__label">Site links</span>
          </summary>
          <div class="footnav">
            <div class="footnav__group">
              <h2 class="footnav__label" id="footnav-browse">Browse</h2>
              <ul class="usa-list usa-list--unstyled" aria-labelledby="footnav-browse">
                <li><a class="usa-footer__primary-link" href={`${APP}/`}>Titles</a></li>
                <li>
                  <a class="usa-footer__primary-link" href={`${APP}/releases`}>Release points</a>
                </li>
              </ul>
            </div>
            <div class="footnav__group">
              <h2 class="footnav__label" id="footnav-learn">Learn</h2>
              <ul class="usa-list usa-list--unstyled" aria-labelledby="footnav-learn">
                <li><a class="usa-footer__primary-link" href={`${APP}/guide`}>User guide</a></li>
                <li><a class="usa-footer__primary-link" href={syntaxHref()}>Search guide</a></li>
                {/* An `<a>` and not a `<button>`, deliberately. Without the island it
                    goes to the chapter that lists the same shortcuts in prose; with
                    it, `KeyboardNav` intercepts the click and opens the dialog. A
                    button would be a control that does nothing when the script has
                    not run, and the destination behind it is a real page. The same
                    progressive-enhancement shape `data-newtab` uses in `Base`. */}
                <li>
                  <a
                    class="usa-footer__primary-link"
                    href={`${APP}/guide/02-reading#keyboard-shortcuts`}
                    data-shortcuts-open
                  >
                    Keyboard shortcuts
                  </a>
                </li>
              </ul>
            </div>
            <div class="footnav__group">
              <h2 class="footnav__label" id="footnav-developers">Developers</h2>
              <ul class="usa-list usa-list--unstyled" aria-labelledby="footnav-developers">
                <li>
                  <a class="usa-footer__primary-link" href={`${APP}/docs`}>API documentation</a>
                </li>
                <li>
                  <a
                    class="usa-footer__primary-link usa-link usa-link--external"
                    rel="noopener"
                    href="https://uscode.house.gov/download/download.shtml">Source XML (OLRC)</a
                  >
                </li>
                <li><a class="usa-footer__primary-link" href={`${APP}/design`}>Design system</a></li>
              </ul>
            </div>
            <div class="footnav__group">
              <h2 class="footnav__label" id="footnav-site">Site</h2>
              <ul class="usa-list usa-list--unstyled" aria-labelledby="footnav-site">
                <li><a class="usa-footer__primary-link" href={`${APP}/about`}>About</a></li>
              </ul>
            </div>
          </div>
        </details>
      </nav>
    </div>
  </div>
  <div class="usa-footer__secondary-section">
    <div class="grid-container">
      <p class="doc-meta">
        A conceptual redesign of the Office of the Law Revision Counsel's site, built from the
        official USLM downloads. Not an official publication of the United States government.
        <a href={`${APP}/about`}>More about this site</a>.
      </p>
      <p class="doc-meta doc-meta--commit">
        Source: <a class="usa-link usa-link--external" rel="noopener" href={repoUrl}>github.com/aih/uscode-redesign</a>{" "}
        — commit <a class="usa-link usa-link--external" rel="noopener" href={commitUrl}><code>{shortHash}</code></a>
      </p>
    </div>
  </div>
</footer>
