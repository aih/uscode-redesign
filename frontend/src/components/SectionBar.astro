---
/**
 * The compact row that stays put while the text scrolls — where you are and
 * where you can go, in one line.
 *
 * This is `NavStrip`'s job plus the section's identity, folded together because
 * they now live in the same sticky stack: rendering the prev/next strip *and* a
 * sticky bar carrying prev/next would put the same two links on screen twice,
 * a few pixels apart. `Neighbors` still sits at the bottom, where a reader who
 * has finished a section is actually looking.
 *
 * Always rendered, never toggled on scroll. An IntersectionObserver that reveals
 * this once the `h1` leaves the viewport would be slightly tidier and would cost
 * the reader a script; the bar is one line either way, so it is simply always
 * there. Nothing here is client-side.
 *
 * On a phone this is the *only* thing that sticks (see `site.scss`): the navbar
 * and the breadcrumb trail scroll away, because at 375px they are ~110px of a
 * ~660px viewport and the point of the exercise is reading.
 *
 * Each step names its neighbour — `← § 45e`, not `←` — from 40em up; below that
 * the number is hidden and the arrow stands alone, because this row may not
 * wrap. The accessible name is the `aria-label` in both cases and contains the
 * visible text, so the two agree at every width (WCAG 2.5.3). `aria-label`
 * rather than a visually-hidden span because USWDS's `.usa-sr-only` lives in
 * `uswds-utilities`, which `site.scss` deliberately does not forward.
 */
import StatusBadge from "./StatusBadge.astro";
import type { Entry } from "../lib/types";
import { appHref, trimNum } from "../lib/url";

interface Props {
  /** The section this page is showing — its own num/heading/status. */
  num?: string | null;
  heading?: string | null;
  status?: string | null;
  previous?: Entry | null;
  next?: Entry | null;
  up?: Entry | null;
  release?: string | null;
}

const {
  num = null,
  heading = null,
  status = null,
  previous = null,
  next = null,
  up = null,
  release = null,
} = Astro.props;

/** `'§ 45f.'` → `'§ 45f'`. The section symbol comes from the source — `num` is
 * literally `§ 45f.` — so this must not add one of its own; `§ § 45f` was the
 * first thing the rendered page showed. */
const label = trimNum(num);

/** `'SUBCHAPTER VI—'` → `'SUBCHAPTER VI'`. USLM carries the trailing dash that
 * separates a heading from its number in print, and the breadcrumb trail keeps
 * it deliberately. Here there is one line for everything, so the dash is the
 * first thing to go — it is punctuation joining this label to a heading that
 * this row does not show. */
function shortNum(entry: Entry | null): string {
  return trimNum(entry?.num).replace(/[—–-]\s*$/u, "").trim();
}

const upLabel = shortNum(up);
---

<nav class="sectionbar" aria-label="Section">
  <div class="sectionbar__inner">
    {
      previous ? (
        <a
          class="sectionbar__step"
          href={appHref(previous.identifier, release)}
          rel="prev"
          aria-label={`Previous section, ${shortNum(previous)}`}
        >
          <span aria-hidden="true">←</span>
          <span class="sectionbar__step-label" aria-hidden="true">
            {shortNum(previous)}
          </span>
        </a>
      ) : (
        <span class="sectionbar__step sectionbar__step--off" aria-hidden="true">
          ←
        </span>
      )
    }

    {/* The identity, and the way back to the top of the section.

        `§ 523` never truncates; the heading gives up its tail first, because a
        reader who has scrolled this far already knows what they are reading and
        needs the number to stay legible.

        The number is a link to `#main`. This row is the only chrome that stays
        put at every width, so it is the only place a "back to the top" can live
        without being another sticky box counted in `--sticky-h` — and the
        token is what `scroll-margin-top` spends, so a second row would move
        every anchor jump on the page. Clicking the thing you are reading to
        return to its start is the behaviour of a document title bar, and the
        accessible name says so rather than leaving it to be guessed at. The
        heading beside it stays plain text: one target, not two adjacent ones
        that do the same thing. */}
    <p class="sectionbar__id">
      {label && (
        <a
          class="sectionbar__num sectionbar__top"
          href="#main"
          aria-label={`Back to the top of ${label}`}
        >
          {label}
        </a>
      )}
      {heading && <span class="sectionbar__heading">{heading}</span>}
      {status && <StatusBadge status={status} />}
    </p>

    {
      up && (
        <a
          class="sectionbar__up"
          href={appHref(up.identifier, release)}
          aria-label={`Up one level, to ${upLabel}`}
        >
          <span aria-hidden="true">↑</span>
          <span class="sectionbar__up-label" aria-hidden="true">
            {upLabel}
          </span>
        </a>
      )
    }

    {
      next ? (
        <a
          class="sectionbar__step"
          href={appHref(next.identifier, release)}
          rel="next"
          aria-label={`Next section, ${shortNum(next)}`}
        >
          <span class="sectionbar__step-label" aria-hidden="true">
            {shortNum(next)}
          </span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="sectionbar__step sectionbar__step--off" aria-hidden="true">
          →
        </span>
      )
    }
  </div>
</nav>
