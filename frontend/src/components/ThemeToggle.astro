---
/**
 * Light or dark, chosen by the reader.
 *
 * The site is light by default at every OS setting (`site.scss`), because a
 * statute is a document and a document's page is white until someone says
 * otherwise. This is how they say otherwise: one button, one attribute
 * (`<html data-theme>`), one `localStorage` key.
 *
 * Three things about it are deliberate.
 *
 *   * **No cookie, no server round trip.** The reader's pages are cached
 *     (ADR-0018); a theme cookie would put `Vary: Cookie` on statutory text
 *     that is identical for everyone. The preference is applied by the client
 *     to bytes that stay shared.
 *   * **The flash is handled in `Base.astro`, not here.** The `<head>`
 *     bootstrap stamps the attribute before first paint; this island only
 *     handles the click, and loads whenever it loads.
 *   * **Hidden until scripted.** Without JavaScript the button cannot do
 *     anything, and a dead control in the chrome is worse than no control. The
 *     script un-hides it — which works only because `[hidden]` is forced to win
 *     over `.usa-button { display: inline-block }` in `site.scss`.
 *
 * The accessible name says what the click will *do* ("Switch to dark mode"),
 * which is unambiguous in a way that a name plus `aria-pressed` on a changing
 * label is not.
 *
 * ## Two buttons, one script
 *
 * `SiteHeader` renders this twice (ADR-0064): once on the mobile bar and once
 * in the More menu's DISPLAY group, with one of the two `display: none` at any
 * width. The script binds every `[data-theme-toggle]` in the document and
 * paints all of them, so the hidden copy is already correct when a resize
 * reveals it.
 *
 * It must ship exactly once, and from the *last* instance on the page: an
 * inline script runs where the parser reaches it, so a copy emitted before the
 * second button cannot bind it. `script={false}` is how the earlier instance
 * says so.
 */
interface Props {
  /** Whether this instance emits the island's script. Exactly one instance on
   *  a page may, and it has to be the last one in document order. */
  script?: boolean;
}

const { script = true } = Astro.props;
---

<button
  type="button"
  class="usa-button usa-button--unstyled theme-toggle"
  data-theme-toggle
  hidden
>
  <span class="theme-toggle__icon" aria-hidden="true">☾</span>
  <span class="theme-toggle__label">Dark</span>
</button>

{script && (
  <script is:inline>
    {
      const KEY = "usc-theme";
      const root = document.documentElement;
      // Every copy — see this file's frontmatter for why there are two.
      const buttons = [...document.querySelectorAll("[data-theme-toggle]")];

      function paint() {
        const dark = root.dataset.theme === "dark";
        // An installed window's title bar follows this meta (ADR-0079); the
        // two values are the token block's `--page`, same as `Base.astro`'s
        // bootstrap writes.
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.setAttribute("content", dark ? "#141310" : "#f9f9f7");
        // The label names the destination, not the current state.
        const name = dark ? "Switch to light mode" : "Switch to dark mode";
        for (const b of buttons) {
          b.querySelector(".theme-toggle__icon").textContent = dark ? "☀" : "☾";
          b.querySelector(".theme-toggle__label").textContent = dark ? "Light" : "Dark";
          b.setAttribute("aria-label", name);
          b.title = name;
          b.hidden = false;
        }
      }

      for (const b of buttons) {
        b.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem(KEY, next);
          } catch {
            // Private mode, or storage full. It applies here and is not
            // remembered, which is better than throwing.
          }
          paint();
        });
      }

      paint();
    }
  </script>
)}
