---
/**
 * The three facts a versioned reader is tempted to drop, and must not:
 *
 *   * the release point and its date (what you are looking at);
 *   * the **caveat** on a `not` release point — at `119-102not101` the text is
 *     current through 07/12/2026 *except* for Public Law 119-101 (gotcha 5);
 *   * the **served-from note** when the requested release point was never
 *     ingested — the answer is right, but it came from another release point and
 *     the page has to say so (gotcha 10).
 *
 * All three sit in the reading column, not in a tooltip.
 */
import type { Release } from "../lib/types";

interface Props {
  served: Release;
  note?: string | null;
}

const { served, note = null } = Astro.props;
const [year, month, day] = served.currency_date.split("-");
---

<p class="doc-meta">
  Release point <span class="doc-meta__rp">{served.label}</span> · current through {month}/{day}/{
    year
  }
</p>

{served.caveat && <p class="caveat">{served.caveat}</p>}
{note && <p class="served-note">{note}</p>}
