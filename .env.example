DATABASE_URL=postgresql+psycopg://uscode:uscode@localhost:5432/uscode

# Whether session cookies carry `Secure` (ADR-0019).
#   auto  — infer it from the request scheme. Right locally; behind a proxy it
#           depends on --proxy-headers and trusted_proxies both being correct,
#           and if either regresses the cookie is downgraded with no error.
#   true  — always. What any deployment served over HTTPS should set.
#   false — never. Only for a deliberately plain-HTTP environment.
USC_COOKIE_SECURE=auto

# The S3 mirror of the corpus (ADR-0013, docs/remote-ops.md). Bucket name only.
# USC_MIRROR_BUCKET=uscode-mirror-dreamproit
