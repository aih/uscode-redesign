DATABASE_URL=postgresql+psycopg://uscode:uscode@localhost:5432/uscode

# Whether session cookies carry `Secure` (ADR-0019).
#   auto  — infer it from the request scheme. Right locally; behind a proxy it
#           depends on --proxy-headers and trusted_proxies both being correct,
#           and if either regresses the cookie is downgraded with no error.
#   true  — always. What any deployment served over HTTPS should set.
#   false — never. Only for a deliberately plain-HTTP environment.
USC_COOKIE_SECURE=auto

# The S3 mirror of the corpus (ADR-0013, docs/remote-ops.md). Bucket name only.
# USC_MIRROR_BUCKET=uscode-mirror-dreamproit

# ------------------------------------------------------------------- search
#
# Keyword search (ADR-0028). `storage/search.py` raises rather than defaulting
# if SEARCH_PASSWORD is unset, so an environment that forgets it gets an error
# instead of a silent attempt at https://localhost:9200 with a password from a
# public repository — which is what it used to do.
#
# Ingest never requires a cluster: DISABLE_SEARCH_SYNC=1 turns indexing off.
SEARCH_URL=https://localhost:9200

# The dev stack's password, which docker-compose.yml also feeds to OpenSearch as
# OPENSEARCH_INITIAL_ADMIN_PASSWORD. It has to satisfy the security plugin's
# strength rule and must not resemble the username — a password containing
# "admin" makes the container exit 1 at boot, and the only sign is a log line.
# Generate a real one for any deployment: openssl rand -base64 24
SEARCH_PASSWORD=Usc0deSearch!Str0ng#2026

# Verify the cluster's TLS certificate. The dev stack's OpenSearch presents the
# self-signed certificate its image generates at first boot, so the dev stack
# sets this to false. Anything else must leave it at true: an unverified
# connection carrying admin credentials is one any host on the path can
# impersonate.
SEARCH_VERIFY_CERTS=false
